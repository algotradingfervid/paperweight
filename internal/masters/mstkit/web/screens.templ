package mstweb

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
)

// Every screen here composes internal/ui components and adds no class of
// its own (CD-98: daisyUI and our utilities live only in internal/ui).

templ listPage(v listView) {
	@layout.Page(layout.PageOpts{Title: v.Title}) {
		@listBody(v)
	}
}

// listMain is the #main fragment an htmx search swaps in.
templ listMain(v listView) {
	@layout.Main(layout.PageOpts{Title: v.Title}) {
		@listBody(v)
	}
}

templ listBody(v listView) {
	@components.FilterBar(v.Bar)
	@components.DataList(v.List)
	@components.Pagination(v.Pages)
	if v.ShowDisabled != nil {
		@components.Button(components.ButtonProps{Label: v.ShowDisabled.Label, Href: v.ShowDisabled.Href, Variant: components.Ghost})
	}
}

// recordPage is the new page and a record's page: the form (with the
// version it was rendered at), or the values for a user without write; a
// refusal banner; the delete confirm step; and More actions.
templ recordPage(v recordView) {
	@recordPageCancelTo(v, v.Action)
}

// recordPageCancelTo is recordPage with the delete confirm step's Cancel going
// to cancel.
templ recordPageCancelTo(v recordView, cancel string) {
	@layout.Page(recordOpts(v)) {
		@recordBody(v, cancel)
	}
}

// recordMain is recordPageCancelTo as the #main fragment the form's htmx post
// swaps in.
templ recordMain(v recordView, cancel string) {
	@layout.Main(recordOpts(v)) {
		@recordBody(v, cancel)
	}
}

templ recordBody(v recordView, cancel string) {
	if v.Disabled {
		@components.StateBadge(disabledState)
	}
	@components.ErrorSummary(v.Form.summary())
	if v.Confirm {
		@components.Card("Delete "+v.Title+"?", nil) {
			<p>This can't be undone.</p>
			@components.Form(components.FormProps{Action: v.Action + "/delete", HX: true}) {
				<input type="hidden" name="version" value={ strconv.Itoa(v.Form.Version) }/>
				@components.ActionBar(components.ActionBarProps{
					Primary:   &components.ButtonProps{Label: "Delete", Variant: components.Danger, Busy: "Deleting…"},
					Secondary: &components.ButtonProps{Label: "Cancel", Href: cancel},
				})
			}
		}
	} else if len(v.Cards) > 0 {
		for _, c := range v.Cards {
			@components.Card(c.Title, c.Change) {
				@components.SummaryList(c.Pairs)
			}
		}
	} else if v.CanWrite {
		@components.Form(components.FormProps{ID: recordFormID, Action: v.Action, HX: true, DisabledElt: "#" + recordFormID + " button[type=submit]"}) {
			if v.ID != 0 {
				<input type="hidden" name="version" value={ strconv.Itoa(v.Form.Version) }/>
			}
			@components.RequiredNote(v.Required)
			for _, in := range grouped(v.Inputs) {
				@in
			}
			@formRows(v.Rows)
			@components.ActionBar(components.ActionBarProps{
				Primary: &components.ButtonProps{Label: "Save", Variant: components.Primary, Busy: "Saving…"},
			})
		}
	} else {
		@components.SummaryList(v.Pairs)
		@readRows(v)
	}
	if !v.Confirm {
		if v.Extra != nil {
			@v.Extra
		}
		@components.MoreActions(v.More)
	}
}

// formRows is the rows editor inside the form, for a master with rows.
templ formRows(rows *components.RowsProps) {
	if rows != nil {
		@components.RowsEditor(*rows)
	}
}

// readRows is the rows for a user without write, as text.
templ readRows(v recordView) {
	if len(v.RowPairs) > 0 {
		@components.Card(v.Rows.Legend, nil) {
			for _, row := range v.RowPairs {
				@components.SummaryList(row)
			}
		}
	}
}

// problemBanner is a refusal with no field: a stale version (409, the
// conflict banner naming the record) or mstkit's "Cannot delete …" (422).
// It takes focus unless the error summary does, which brings it into view
// after an htmx swap has kept the scroll (CD-384).
templ problemBanner(v recordView) {
	if v.Form.Problem != "" && len(v.Form.Errs) == 0 {
		<div id="record-alert" tabindex="-1" autofocus>
			@problemNotice(v)
		</div>
	} else if v.Form.Problem != "" {
		@problemNotice(v)
	}
}

templ problemNotice(v recordView) {
	if v.Form.Reload {
		@components.ConflictBanner(v.Form.Problem, v.Label, v.Action)
	} else {
		@components.Banner(components.BannerProps{Kind: components.Danger, Message: v.Form.Problem})
	}
}

// problemPage is a refusal shown on its own page: AUTH's 403 and 404, or a
// form without its version (400).
templ problemPage(msg string, back components.Link) {
	@layout.Page(layout.PageOpts{Title: msg, Error: true, Back: &back})
}

// moreGroup is b's inputs in a MoreDetails.
templ moreGroup(b moreBox) {
	@components.MoreDetails(b.labels, b.open) {
		for _, c := range b.inputs {
			@c
		}
	}
}
