package mstweb

import (
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
	"github.com/vardhan/internaltools/internal/ui/wizard"
)

// wizardPage is one step of a create wizard as a whole page.
templ wizardPage(v wizardView) {
	@layout.Page(wizardOpts(v)) {
		@wizardBody(v)
	}
}

func wizardOpts(v wizardView) layout.PageOpts {
	return layout.PageOpts{
		Title:     v.M.Heading(),
		NoHeading: true, // the frame's heading is the page's
		Focus:     true,
		Error:     len(v.M.Errors) > 0,
		Width:     layout.Form,
		Back:      &v.Back,
	}
}

// wizardFrame is the htmx answer for a step: its <title>, so the document
// title follows each step and refusal, then the #wizard fragment.
templ wizardFrame(v wizardView) {
	@layout.Title(wizardOpts(v))
	@wizardBody(v)
}

// wizardBody is the #wizard element.
templ wizardBody(v wizardView) {
	@wizard.Frame(v.M, v.Bar) {
		@stepNote(v.Note)
		@components.RequiredNote(v.Required)
		for _, in := range grouped(v.Inputs) {
			@in
		}
	}
}

// wizardCheck is Check's summary, one section per step with Change
// and its step's icon tile (UI v2 §5.6).
templ wizardCheck(cards []sectionCard) {
	for _, c := range cards {
		@wizard.CheckSection(c.Title, c.Icon, "", c.Change.Href) {
			@cardPairs(c)
		}
	}
}

// wizardStartOverForm goes below the action bar, as its own form.
templ wizardStartOverForm(action string) {
	@components.Form(components.FormProps{Action: action}) {
		@components.Button(components.ButtonProps{Label: "Start over", Variant: components.Ghost})
	}
}

// stepNote is a status line for what the last Continue did: the empty rows it
// left out.
templ stepNote(note string) {
	if note != "" {
		@components.Banner(components.BannerProps{Kind: components.Info, Message: note})
	}
}
