package mstweb

import (
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
	"github.com/vardhan/internaltools/internal/ui/wizard"
)

// wizardPage is one step of a create wizard as a whole page.
templ wizardPage(v wizardView) {
	@layout.Page(layout.PageOpts{
		Title:     v.M.Heading(),
		NoHeading: true, // the frame's heading is the page's
		Focus:     true,
		Error:     len(v.M.Errors) > 0,
		Width:     layout.Form, // no Back: the wizard head's × is the one exit (UI v2 §5.6)
	}) {
		@wizardFrame(v)
	}
}

// wizardFrame is the #wizard fragment.
templ wizardFrame(v wizardView) {
	@wizard.Frame(v.M, v.Bar) {
		@components.RequiredNote(v.Required)
		for _, in := range grouped(v.Inputs) {
			@in
		}
	}
}

// wizardCheck is Check's summary, one section per step with Change
// and its step's icon tile (UI v2 §5.6).
templ wizardCheck(cards []sectionCard) {
	for _, c := range cards {
		@wizard.CheckSection(c.Title, c.Icon, "", c.Change.Href) {
			@components.SummaryList(c.Pairs)
			for _, row := range c.Rows {
				@components.SummaryList(row)
			}
		}
	}
}

// startOverID is the Start over dialog's id.
const startOverID = "start-over-wizard"

// wizardStartOverForm goes below the action bar, as its own form. Start over
// asks first (UI v2 §7, destructive actions confirm): the dialog's Start over
// posts the form; without JavaScript the first press posts it.
templ wizardStartOverForm(action string) {
	@components.Form(components.FormProps{Action: action}) {
		@components.Button(components.ButtonProps{Label: "Start over", Variant: components.Ghost, Attrs: templ.Attributes{"data-open-dialog": startOverID, "aria-haspopup": "dialog"}})
		@components.Dialog(startOverID, "Start over?") {
			<p>What you typed in this wizard is cleared.</p>
			<div class="cluster">
				@components.Button(components.ButtonProps{Label: "Keep editing", Type: "button", Attrs: templ.Attributes{"data-close-dialog": true}})
				@components.Button(components.ButtonProps{Label: "Start over", Variant: components.Danger})
			</div>
		}
	}
}
