package modkitweb

import (
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
)

// settingsPage is the business settings form (PO spec §14.1), composed like
// Company's single-record form: a refusal banner (stale, with Reload), the
// error summary, and the fields with the version the page was rendered at.
templ settingsPage(v settingsView) {
	@layout.Page(layout.PageOpts{
		Title:      pageTitle,
		Error:      v.Problem != "" || v.LockErr != "",
		Width:      layout.Form,
		BannerSlot: problemBanner(v.Problem),
	}) {
		@components.ErrorSummary(v.summary())
		@components.Form(components.FormProps{Action: settingsPath}) {
			<input type="hidden" name="version" value={ v.Version }/>
			@components.DateInput(components.DateProps{
				FieldProps: components.FieldProps{
					ID: lockID, Name: "locked_up_to", Label: "Locked up to", Hint: lockHint,
					Value: v.LockedUpTo, Error: v.LockErr, Clearable: true,
				},
				Today: v.Today, Yesterday: v.Yesterday,
			})
			@components.Textarea(components.FieldProps{
				ID: components.FieldID("default_po_terms"), Name: "default_po_terms", Label: "Default PO terms",
				Hint: termsHint, Value: v.Terms, Clearable: true,
			}, termsMaxLen)
			@components.ActionBar(components.ActionBarProps{
				Primary: &components.ButtonProps{Label: "Save", Variant: components.Primary, Busy: "Saving…"},
			})
		}
	}
}

// problemBanner is a refusal with no field: a stale version (409), with
// Reload. It renders nothing without one.
templ problemBanner(msg string) {
	if msg != "" {
		@components.Banner(components.BannerProps{Kind: components.Danger, Message: msg, Link: &components.Link{Label: "Reload", Href: settingsPath}})
	}
}
