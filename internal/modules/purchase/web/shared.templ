package purchaseweb

import "github.com/vardhan/internaltools/internal/ui/components"

// ownerCardView is the Owner card: its text and Hand over to href.
templ ownerCardView(href string) {
	@components.Card(ownerCardTitle, nil) {
		<p>{ ownerCardText }</p>
		@components.Button(components.ButtonProps{Label: handOverLabel, Href: href})
	}
}

// inputsView is a step's inputs, in order.
templ inputsView(inputs []templ.Component) {
	for _, c := range inputs {
		@c
	}
}

// totalsCard is the document page's totals.
templ totalsCard(pairs []components.Pair) {
	@components.Card(totalsTitle, nil) {
		@components.SummaryList(pairs)
	}
}

// aboveStep is a revised draft's rejection banner above a step's own part.
templ aboveStep(reason string, part templ.Component) {
	if reason != "" {
		@components.Banner(components.BannerProps{Kind: components.Warning, Message: reason})
	}
	@part
}

// linkedRowsView is a card of linked records, the Goods receipts (UX §5.9)
// or Linked orders (UX §5.16) section: a DataList row per readable record,
// then others, the count of the rest with no state or link; with neither,
// the empty text.
templ linkedRowsView(title, empty string, columns []components.Column, rows []components.Row, others string) {
	@components.Card(title, nil) {
		if len(rows) > 0 {
			@components.DataList(components.DataListProps{Label: title, Columns: columns, Rows: rows})
		} else if others == "" {
			<p>{ empty }</p>
		}
		if others != "" {
			<p>{ others }</p>
		}
	}
}
