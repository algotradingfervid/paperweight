package expenseweb

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
)

templ paidFull(s paidScreen) {
	@layout.Page(paidOpts(s)) {
		@paidBody(s)
	}
}

templ paidMain(s paidScreen) {
	@layout.Main(paidOpts(s)) {
		@paidBody(s)
	}
}

templ paidBanners(s paidScreen) {
	if s.danger != "" {
		<div id="paid-alert" tabindex="-1" autofocus>
			if s.reload != nil {
				@components.ConflictBanner(s.danger, s.reload.Label, s.reload.Href)
			} else {
				@components.Banner(components.BannerProps{Kind: components.Danger, Message: s.danger})
			}
		</div>
	}
	@components.ErrorSummary(s.errs)
}

// paidBody is the summary, Undo paid's text, then the form: the version and
// the Paid on date on Mark as paid. Its button is the sticky bar's (paidOpts).
templ paidBody(s paidScreen) {
	<h1
		id="page-title"
		tabindex="-1"
		if s.focusHeading {
			autofocus
		}
	>{ s.opts.Title }</h1>
	<p>{ s.summary }</p>
	if s.question != "" {
		<p>{ s.question }</p>
	}
	@components.Form(components.FormProps{ID: paidFormID, Action: s.action, HX: true}) {
		<input type="hidden" name="version" value={ strconv.Itoa(s.version) }/>
		if s.date != nil {
			@components.DateInput(*s.date)
		}
	}
}
