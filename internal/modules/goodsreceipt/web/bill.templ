package grnweb

import "github.com/vardhan/internaltools/internal/ui/components"

// billCard is the Bill details card (UX §5.7) inside the element with id
// "bill", the target of its own htmx form: a refusal's message and error
// summary first, then the saved status, the empty text, the tax invoice
// note, the read view's values and lines, its information line, the
// duplicate warning and the form.
templ billCard(v billView) {
	<div id="bill">
		@components.Card(billTitle, v.Change) {
			if v.Msg != nil {
				@components.Banner(*v.Msg)
			}
			@components.ErrorSummary(v.Errs)
			if v.Saved {
				<p role="status">{ billSaved }</p>
			}
			if v.Empty {
				@components.EmptyState(billEmpty, nil)
			}
			if v.Note != "" {
				@components.Banner(components.BannerProps{Kind: components.Info, Message: v.Note})
			}
			if len(v.Rows) > 0 {
				@components.SummaryList(v.Rows)
			}
			for _, l := range v.Lines {
				<p>{ l }</p>
			}
			for _, i := range v.Info {
				@components.Banner(components.BannerProps{Kind: components.Info, Message: i, NoRole: true})
			}
			@components.Warnings(v.Warnings)
			if v.Form != nil {
				@components.Form(components.FormProps{Action: v.Form.Action, HX: true, Target: "#bill"}) {
					@components.Hidden("version", v.Form.Version)
					<p>{ billHint }</p>
					@components.TextInput(v.Form.No)
					@components.DateInput(v.Form.Date)
					@components.MoneyInput(v.Form.Amount)
					@components.Button(v.Form.Save)
				}
			}
		}
	</div>
}
