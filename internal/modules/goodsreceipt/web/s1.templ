package grnweb

import "github.com/vardhan/internaltools/internal/ui/components"

// choosePOView is step 1 with the order still open to choose (UX doc §5.2):
// the radios, the select or the combobox, or the empty text, then the link
// that widens or narrows the orders, then the receipt date when showDate
// (Hide shows it, CD-319).
templ choosePOView(p poPick, date components.DateProps, showDate bool) {
	if p.Search != nil {
		@components.Picker(*p.Search)
	} else if len(p.Options) == 0 {
		@components.EmptyState(msgNoOrders, p.EmptyLink)
		<p>{ msgAskBuyer }</p>
	} else if p.Select {
		@components.Select(p.Field, p.Options)
	} else {
		@components.Radios(p.Field, p.Options)
	}
	if p.All {
		@components.Hidden("all", "1")
	}
	if p.Toggle != nil {
		@components.Button(components.ButtonProps{Label: p.Toggle.Label, Href: p.Toggle.Href, Variant: components.Ghost})
	}
	if showDate {
		@components.DateInput(date)
	}
}

// fixedPOView is step 1 of a draft with lines: its order as text, the hint
// that says how to change it, Delete draft for a user who may, and the
// receipt date when showDate (UX doc §5.2, spec §3.1). The stored order
// posts as poID, which detailsSave checks.
templ fixedPOView(po []components.Pair, poID, deleteHref string, date components.DateProps, showDate bool) {
	@components.SummaryList(po)
	@components.Hidden("purchase_order_id", poID)
	<p>{ msgDeleteToChange }</p>
	if deleteHref != "" {
		@components.Button(components.ButtonProps{Label: deleteDraftLabel, Href: deleteHref, Variant: components.Secondary})
	}
	if showDate {
		@components.DateInput(date)
	}
}

// deliveryView is step 2 (UX doc §5.3): the inputs, then the More ones in
// a MoreDetails, or without one when every shown input is More (CD-363),
// then where the photo is taken.
templ deliveryView(d deliveryForm) {
	for _, in := range d.Inputs {
		@in
	}
	if len(d.Inputs) == 0 {
		for _, in := range d.More.inputs {
			@in
		}
	} else if len(d.More.inputs) > 0 {
		@components.MoreDetails(d.More.labels, d.More.open) {
			for _, in := range d.More.inputs {
				@in
			}
		}
	}
	<p>{ msgPhotoLater }</p>
}
