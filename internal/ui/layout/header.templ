package layout

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/platform/brand"
	"github.com/vardhan/internaltools/internal/ui"
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/icons"
)

// SearchMaxLen is the longest search text, in characters (CD-200 part 4).
const SearchMaxLen = 100

// header is the 56 px app header (UI v2 §5.2): menu button (phones), brand
// (logo and the app name, once), search form (from 48rem, signed in), the
// New button (from 64rem), inbox link and the account chip with its menu
// (from 48rem; the bottom nav has them on phones, CD-349). Bare drops the
// menu button, the search form, New and the inbox.
templ header(o PageOpts, s ui.Shell) {
	<header class="app-header">
		if !o.Bare {
			<button type="button" class="btn btn-ghost btn-square menu-button" aria-label="Menu" aria-haspopup="dialog" aria-controls="nav-sheet" data-open-dialog="nav-sheet">
				@icons.Icon("menu")
			</button>
		}
		<a class="brand" href="/">
			<img class="brand-logo" src={ brand.AppLogoURL } width={ strconv.Itoa(brand.AppLogoWidth) } height={ strconv.Itoa(brand.AppLogoHeight) } alt=""/>
			<span class="brand-name truncate">{ s.AppName }</span>
		</a>
		if s.SignedIn && !o.Bare {
			<form class="header-search" role="search" method="get" action="/search">
				@icons.Icon("search")
				<label class="visually-hidden" for="header-q">Search</label>
				<input id="header-q" class="input" type="search" name="q" maxlength={ strconv.Itoa(SearchMaxLen) } placeholder="Search orders, parties, items…"/>
				<kbd aria-hidden="true">/</kbd>
			</form>
		}
		<div class="header-end">
			if s.SignedIn && !o.Bare {
				<span class="header-new">
					@components.Button(components.ButtonProps{Label: "New", Icon: "plus", Href: newPath, Variant: components.Primary, Attrs: templ.Attributes{"aria-haspopup": "dialog", "data-open-dialog": newSheetID}})
				</span>
			}
			if !o.Bare {
				<a class="btn btn-ghost inbox-link" href={ templ.SafeURL(inboxPath) } aria-label={ inboxLabel(s.InboxCount) }>
					@icons.Icon("inbox")
					if s.InboxCount > 0 {
						<span class="badge badge-primary" aria-hidden="true">{ strconv.Itoa(s.InboxCount) }</span>
					}
				</a>
			}
			if s.SignedIn {
				<details class="user-menu">
					<summary class="btn btn-ghost" aria-label={ "Account menu: " + s.User }>
						<span class="avatar-initials" aria-hidden="true" data-initials={ initials(s.User) }></span>
						<span class="user-name truncate">{ s.User }</span>
					</summary>
					<div class="user-menu-panel">
						<form method="post" action="/signout">
							<input type="hidden" name="csrf_token" value={ s.CSRF }/>
							<button type="submit" class="btn btn-ghost w-full">
								@icons.Icon("log-out")
								Sign out
							</button>
						</form>
					</div>
				</details>
			}
		</div>
	</header>
}
