package layout

import (
	"strconv"
	"strings"

	"github.com/vardhan/internaltools/internal/ui"
	"github.com/vardhan/internaltools/internal/ui/icons"
)

// navList is the sidebar's navigation (UI v2 §5.2).
templ navList(s ui.Shell) {
	@navGroups(s, "side")
}

// navGroups is the main navigation in groups, each under an h2 that labels
// its links, with the group's More items in a disclosure at its end. The item
// whose Href is the longest prefix of Shell.Path is the current page; prefix
// keeps the heading ids of the sidebar and the phone sheet apart.
templ navGroups(s ui.Shell, prefix string) {
	{{ cur := currentHref(s.Nav, s.Path) }}
	<div class="nav-list">
		for _, g := range groupNav(s.Nav) {
			if g.Name != "" {
				<h2 class="nav-group" id={ groupID(prefix, g.Name) }>{ g.Name }</h2>
			}
			<ul class="nav-links" { groupAttrs(prefix, g.Name)... }>
				for _, it := range g.Items {
					@navLink(it, cur, s.InboxCount)
				}
				if len(g.More) > 0 {
					<li>
						<details class="nav-more" open?={ moreOpen(g.More, cur) }>
							<summary>
								@icons.Icon("ellipsis")
								<span class="nav-label">More { strings.ToLower(g.Name) }</span>
								@icons.Icon("chevron-down")
							</summary>
							<ul class="nav-links">
								for _, it := range g.More {
									@navLink(it, cur, s.InboxCount)
								}
							</ul>
						</details>
					</li>
				}
			</ul>
		}
	</div>
}

// navLink is one item; Approvals carries the inbox count.
templ navLink(it ui.NavItem, cur string, inbox int) {
	<li>
		<a
			href={ templ.SafeURL(it.Href) }
			if it.Href == cur {
				aria-current="page"
			}
		>
			if it.Icon != "" {
				@icons.Icon(it.Icon)
			}
			<span class="nav-label">{ it.Label }</span>
			if it.Href == inboxPath && inbox > 0 {
				<span class="nav-badge">{ strconv.Itoa(inbox) }<span class="visually-hidden">{ " waiting" }</span></span>
			}
		</a>
	</li>
}

// navSheet is the phone navigation: a native dialog opened by the menu button.
templ navSheet(s ui.Shell) {
	<dialog id="nav-sheet" class="modal modal-start sheet" aria-label="Menu">
		<div class="modal-box nav-sheet-box">
			<button type="button" class="btn btn-ghost btn-square" aria-label="Close menu" data-close-dialog>
				@icons.Icon("x")
			</button>
			<nav aria-label="Main">
				@navGroups(s, "sheet")
			</nav>
		</div>
	</dialog>
}
