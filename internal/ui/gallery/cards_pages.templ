package gallery

import (
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/uitest"
)

// cardsBody is Card v2 and MoreDetails (UI v2 §5.5 items 1 and 3): a form
// card with a closed group, a worst-case card with an open one, and a card
// that saves by swapping itself and takes focus on its heading (CD-358).
templ cardsBody() {
	@components.CardWith(components.CardProps{Title: "Vendor and delivery", Icon: "truck", Description: "The vendor gets the order; goods come to the site."}) {
		<div class="stack">
			@components.TextInput(components.FieldProps{ID: "c-vendor", Name: "vendor", Label: "Vendor", Placeholder: "e.g. Shree Steel Traders", Required: true})
			@components.MoreDetails([]string{"Project", "Required by"}, false) {
				@components.TextInput(components.FieldProps{ID: "c-project", Name: "project", Label: "Project"})
				@components.DateInput(components.DateProps{FieldProps: components.FieldProps{ID: "c-need-by", Name: "need_by", Label: "Required by"}, Today: "24-10-2026", Yesterday: "23-10-2026"})
			}
		</div>
	}
	@components.CardWith(components.CardProps{Title: uitest.LongName100, Icon: "handshake", Description: uitest.LongError, Change: &components.Link{Label: "Change", Href: "/_gallery/cards"}}) {
		@components.MoreDetails([]string{"Payment terms", "Bill in company GSTIN"}, true) {
			@components.TextInput(components.FieldProps{ID: "c-terms", Name: "terms", Label: "Payment terms", Value: uitest.LongName100})
			@components.TextInput(components.FieldProps{ID: "c-gstin", Name: "gstin", Label: "Bill in company GSTIN", Error: uitest.LongError})
		}
	}
	@billCard(false, "")
}

// billCard is the card that saves itself: the form swaps the card, and the
// answer sets FocusHeading so focus lands on the heading.
templ billCard(focus bool, saved string) {
	@components.CardWith(components.CardProps{Title: "Bill details", Icon: "receipt-indian-rupee", Description: "As printed on the vendor's bill.", FocusHeading: focus}) {
		@components.Form(components.FormProps{ID: "bill-form", Action: "/_gallery/cards", HX: true, Target: "closest section", Swap: "outerHTML"}) {
			<div class="stack">
				@components.TextInput(components.FieldProps{ID: "c-bill", Name: "bill", Label: "Bill number", Value: saved})
				if saved != "" {
					<p role="status">Saved bill { saved }.</p>
				}
				@components.Button(components.ButtonProps{Label: "Save bill", Variant: components.Primary})
			</div>
		}
	}
}
