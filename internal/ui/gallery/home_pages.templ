package gallery

import (
	"github.com/vardhan/internaltools/internal/kernel/doctype"
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
	"github.com/vardhan/internaltools/internal/ui/uitest"
)

// sampleCounts are count cards with the worst cases: 9,999, a 100-character
// label and detail, the hot card and a card without a detail.
var sampleCounts = []components.StatCardProps{
	{Count: 2, Label: "To approve", Detail: "2 waiting for your approval", Icon: "check-check", Href: "/_gallery/statcard", Hot: true},
	{Count: 9999, Label: "My drafts", Detail: "9,999 orders · 9,999 need changes", Icon: "pencil-line", Href: "/_gallery/statcard"},
	{Count: 1, Label: uitest.LongName100, Detail: uitest.LongName100, Icon: "truck", Href: "/_gallery/statcard"},
	{Count: 7, Label: "To send", Icon: "send", Href: "/_gallery/statcard"},
}

// sampleQuick are quick actions, one with a 100-character label.
var sampleQuick = []components.QuickActionProps{
	{Icon: "shopping-cart", Label: "New purchase order", Href: "/_gallery/quickaction"},
	{Icon: "clipboard-list", Label: "New purchase request", Href: "/_gallery/quickaction"},
	{Icon: "list-checks", Label: "Pending items", Href: "/_gallery/quickaction"},
	{Icon: "truck", Label: uitest.LongName100, Href: "/_gallery/quickaction"},
}

// sampleHomeRows are home rows with a 60-character number, the largest
// amount and a 100-character party.
func sampleHomeRows(n int, meta string) components.DataListProps {
	p := components.DataListProps{Label: "Sample documents", Columns: []components.Column{
		{Key: "title", Label: "Number", Priority: components.PTitle, Code: true, NoWrap: true},
		{Key: "total", Label: "Total", Priority: components.PFigure, Num: true},
		{Key: "m0", Label: "Details", Priority: components.PMeta},
		{Key: "state", Label: "State", Priority: components.PState},
	}}
	titles := []string{uitest.LongCode60, "PO/26-27/00041", "Draft 57", "PO/26-27/00040", "Draft 58"}
	for i := range n {
		p.Rows = append(p.Rows, components.Row{
			Href: "/_gallery/module-home", Party: uitest.LongName100, State: doctype.StatePending,
			Values: map[string]string{"title": titles[i%len(titles)], "total": uitest.MaxMoney, "m0": meta},
		})
	}
	return p
}

templ statcardBody() {
	<ul class="statcards" role="list" aria-label="Sample counts">
		for _, c := range sampleCounts {
			<li>
				@components.StatCard(c)
			</li>
		}
	</ul>
}

templ quickactionBody() {
	<div class="newtiles">
		for _, q := range sampleQuick {
			@components.QuickAction(q)
		}
	</div>
}

// moduleHomeBody is the module home with every part filled; with empty set
// it is a new user's home: nothing waiting and the quick actions.
func moduleHomeBody(empty bool) templ.Component {
	if empty {
		return layout.HomeBody(layout.HomeProps{Title: "Purchase", Quick: sampleQuick[:2]})
	}
	return layout.HomeBody(layout.HomeProps{
		Title:      "Purchase",
		Counts:     sampleCounts,
		Waiting:    sampleHomeRows(3, "Needs your approval · "+uitest.LongName100),
		WaitingAll: &components.Link{Label: "See all 9,999", Href: "/_gallery/module-home"},
		Recent:     sampleHomeRows(5, ""),
		RecentAll:  &components.Link{Label: "All purchase orders", Href: "/_gallery/module-home"},
		Quick:      sampleQuick,
	})
}
