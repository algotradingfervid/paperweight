package gallery

import (
	"github.com/vardhan/internaltools/internal/kernel/doctype"
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/uitest"
)

// docHeaderBody is the document header with the worst cases: a 60-character
// number, the largest amount, four 100-character facts and five steps with
// dates and a note, then the rejected and closed rows of steps, and the
// success block with a 100-character name and two follow-ups (UI v2 §5.13,
// N14, E5b).
templ docHeaderBody() {
	@components.SuccessBlock(components.SuccessProps{
		Message: "Submitted for approval to " + uitest.LongName100 + ".",
		Links:   []components.Link{{Label: "New purchase order", Href: "#new"}, {Label: uitest.LongName100, Href: "#home"}},
	})
	@components.DocHeader(components.DocHeaderProps{
		Title: uitest.LongCode60, State: doctype.StatePending,
		Amount: uitest.MaxMoney, InWords: "Rupees Ninety Nine Crore Ninety Nine Lakh Ninety Nine Thousand Nine Hundred Ninety Nine and Paise Ninety Nine Only",
		Facts: []components.Pair{
			{Label: "Vendor", Value: uitest.LongName100}, {Label: "Deliver to", Value: uitest.LongName100},
			{Label: "Order date", Value: "30-10-2026", Num: true}, {Label: uitest.LongName100, Value: uitest.LongCode60, Code: true},
		},
		Steps: []components.LifeStep{
			{Label: "Draft", Mark: components.LifeDone, Date: "28-10"}, {Label: "Pending approval", Mark: components.LifeDone, Date: "29-10"},
			{Label: "Approved", Mark: components.LifeDone, Date: "30-10"}, {Label: "Sent", Mark: components.LifeDone, Date: "31-10"},
			{Label: "Received", Mark: components.LifeCurrent, Note: "Part"},
		},
	})
	@components.Card("Rejected", nil) {
		@components.StatusTimeline([]components.LifeStep{
			{Label: "Draft", Mark: components.LifeDone}, {Label: "Rejected", Mark: components.LifeRejected}, {Label: "Approved"},
		})
	}
	@components.Card("Closed", nil) {
		@components.StatusTimeline([]components.LifeStep{
			{Label: "Draft", Mark: components.LifeDone}, {Label: "Pending approval", Mark: components.LifeDone},
			{Label: "Approved", Mark: components.LifeDone}, {Label: "Closed", Mark: components.LifeEnded},
		})
	}
}

// docDisplayBody is the document display's worst cases, for the layout checks
// at every width (UI review R9): every real lifecycle with its dates and note,
// every length of amount in a header, and kv rows of money and text.
templ docDisplayBody() {
	for _, steps := range docDisplaySteps {
		@components.Card("", nil) {
			@components.StatusTimeline(steps)
		}
	}
	for _, a := range docDisplayAmounts {
		@components.DocHeader(components.DocHeaderProps{Title: "PO/26-27/00001", State: doctype.StateApproved, Amount: a, Facts: []components.Pair{{Label: "Total", Value: a, Num: true}}})
	}
	@components.Card("Details", nil) {
		@components.SummaryList(docDisplayPairs)
	}
}
