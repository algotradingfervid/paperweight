package components

// Dialog is a native modal dialog opened with showModal(); children are the body.
templ Dialog(id, title string) {
	@dialogBox(id, title, "modal dialog") {
		{ children... }
	}
}

// Sheet is a dialog that slides from the bottom on phones and is centred from 48rem.
templ Sheet(id, title string) {
	@dialogBox(id, title, "modal modal-bottom md:modal-middle dialog sheet") {
		{ children... }
	}
}

templ dialogBox(id, title, class string) {
	<dialog id={ id } class={ class } aria-labelledby={ id + "-title" }>
		<div class="modal-box">
			<div class="dialog-head">
				<h2 id={ id + "-title" }>{ title }</h2>
				@Button(ButtonProps{AriaLabel: "Close", Icon: "x", Type: "button", Variant: Ghost, Attrs: templ.Attributes{"data-close-dialog": true}})
			</div>
			{ children... }
		</div>
	</dialog>
}
