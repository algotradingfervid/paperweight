package components

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// LineList is the line cards, the running taxable total and "Add an item"
// (design-system §8.2), or AddLabel; AddTop puts it above the cards, and
// Empty is the text with no lines (UX-E2). Editable adds Change, Remove and
// the move buttons, which are POST forms. With Grid set, the LineGrid
// follows and replaces the cards from 64rem; with Display it is the
// read-only displayGrid.
templ LineList(p LineListProps) {
	<div
		if len(p.Grid) > 0 {
			class="linelist linelist--grid"
		} else {
			class="linelist"
		}
	>
		if p.Editable && p.AddTop {
			@Button(p.AddButton())
		}
		if p.Total == 0 && p.Empty != "" {
			@EmptyState(p.Empty, nil)
		}
		<ol class="lines">
			for _, c := range p.Cards {
				<li class="lines-card">
					<div class="lines-top">
						<span class="lines-no">{ strconv.Itoa(c.No) }</span>
						<span class="lines-name">
							<span>{ c.Item }</span>
							<span class="code">{ c.Code }</span>
						</span>
						<span class="num lines-amount">{ c.Amount }</span>
					</div>
					if c.Receipt != nil {
						<div class="lines-receipt">
							@attachmentItems([]Attachment{compact(*c.Receipt)}, "", lineAria("Receipt for", c.No))
						</div>
					}
					<p class="lines-meta">
						<span class="num">{ c.QtyRate }</span>
						<span>{ c.Tax }</span>
					</p>
					if c.Received != "" {
						<p class="lines-meta">{ c.Received }</p>
					}
					if c.Note != "" {
						<p class="lines-meta">{ c.Note }</p>
					}
					if c.ReceiptNote != "" {
						<p class="lines-meta lines-receipt-note">
							if c.ReceiptWarn {
								@icons.Icon("alert-circle")
							}
							<span>{ c.ReceiptNote }</span>
						</p>
					}
					if p.Editable {
						@lineActions("lines-actions", lineActionsProps{No: c.No, ChangeURL: c.ChangeURL, RemoveURL: c.RemoveURL, MoveUpURL: c.MoveUpURL, MoveDownURL: c.MoveDownURL, Version: c.Version})
					}
				</li>
			}
		</ol>
		if p.Total > len(p.Cards) {
			<div class="lines-more">
				@Button(ButtonProps{Label: "Show all " + strconv.Itoa(p.Total) + " lines", Href: p.ShowAllURL, Variant: Secondary})
				@Form(FormProps{Action: p.FindURL, Method: "get"}) {
					<div class="lines-find">
						@TextInput(FieldProps{ID: "line-find", Name: "find", Label: "Find a line", Value: p.Find})
						@Button(ButtonProps{Label: "Find", Busy: "Finding…", Icon: "search", Variant: Secondary})
					</div>
				}
			</div>
		}
		if p.TaxableTotal != "" {
			<p class="lines-total">
				<span>Taxable total</span>
				<span class="num">{ p.TaxableTotal }</span>
			</p>
		}
		if p.Editable && !p.AddTop {
			@Button(p.AddButton())
		}
		if len(p.Grid) > 0 && p.Display {
			@displayGrid(p.Grid, p.TaxableTotal)
		} else if len(p.Grid) > 0 {
			@LineGrid(p.Grid, p.TaxableTotal)
		}
	</div>
}

// displayGrid is the read-only line grid from 64rem (CD-313): each cell's
// Text, with Sub as a muted second line; a number cell (Kind) takes the
// content minimum of its input. The row's actions are links and move forms,
// and its note is a full-width row under it.
templ displayGrid(rows []LineGridRow, total string) {
	<div class="line-editor">
		<div class={ "linegrid", gridCols(rows) }>
			if len(rows) > 0 {
				<div class="linegrid-head" aria-hidden="true">
					<span>#</span>
					for _, c := range rows[0].Cells {
						if c.Kind != "" {
							<span class="num">{ c.Label }</span>
						} else {
							<span>{ c.Label }</span>
						}
					}
					<span class="num">Amount</span>
					<span>Actions</span>
				</div>
			}
			for _, r := range rows {
				<div class="linegrid-row">
					<span class="linegrid-no"><span class="visually-hidden">Line</span>{ strconv.Itoa(r.No) }</span>
					for _, c := range r.Cells {
						<div class="linegrid-cell">
							<span class="visually-hidden">{ c.Label }</span>
							if c.Kind != "" {
								<span class="num" data-kind={ c.Kind }>{ c.Text }</span>
							} else {
								<span>{ c.Text }</span>
							}
							if c.Sub != "" {
								<span class="linegrid-sub">{ c.Sub }</span>
							}
						</div>
					}
					<span class="num linegrid-amount"><span class="visually-hidden">Amount</span>{ r.Amount }</span>
					@lineActions("linegrid-actions", lineActionsProps{No: r.No, ChangeURL: r.ChangeURL, RemoveURL: r.RemoveURL, MoveUpURL: r.MoveUpURL, MoveDownURL: r.MoveDownURL, Version: r.Version})
					if r.Note != "" {
						<p class="linegrid-note">{ r.Note }</p>
					}
				</div>
			}
			if total != "" {
				<p class="linegrid-total">
					<span>Taxable total</span>
					<span class="num">{ total }</span>
				</p>
			}
		</div>
	</div>
}

// LineGrid is the desktop line editor, shown from 64rem. Each row is its own
// form that saves on change and swaps only itself; saves queue one at a
// time on #line-editor and each sends the page's #doc-version (CD-95). The
// row's actions sit beside its form, since forms can't nest (CD-139).
templ LineGrid(rows []LineGridRow, total string) {
	<div id="line-editor" class="line-editor">
		<div class={ "linegrid", gridCols(rows) } x-data="linegrid">
			if len(rows) > 0 {
				<div class="linegrid-head" aria-hidden="true">
					<span>#</span>
					for _, c := range rows[0].Cells {
						<span>{ c.Label }</span>
					}
					<span class="num">Amount</span>
					<span>Actions</span>
				</div>
			}
			for _, r := range rows {
				<div class="linegrid-row">
					@LineGridRowForm(r)
					<div class="linegrid-actions">
						if r.RemoveURL != "" {
							@Button(ButtonProps{Label: "Remove", AriaLabel: lineAria("Remove", r.No), Href: r.RemoveURL, Variant: Ghost})
						}
						if r.MoveUpURL != "" {
							@Form(FormProps{Action: r.MoveUpURL}) {
								@versionInput(r.Version, moveVersionID(r.No, "up"))
								@Button(ButtonProps{Label: "Move up", AriaLabel: lineAria("Move up", r.No), Icon: "arrow-up", Variant: Ghost})
							}
						}
						if r.MoveDownURL != "" {
							@Form(FormProps{Action: r.MoveDownURL}) {
								@versionInput(r.Version, moveVersionID(r.No, "down"))
								@Button(ButtonProps{Label: "Move down", AriaLabel: lineAria("Move down", r.No), Icon: "arrow-down", Variant: Ghost})
							}
						}
						if r.Note != "" {
							<p>{ r.Note }</p>
						}
					</div>
				</div>
			}
			if total != "" {
				<p id="grid-total" class="linegrid-total">
					<span>Taxable total</span>
					<span class="num">{ total }</span>
				</p>
			}
		</div>
	</div>
}

// LineGridRowForm is one grid row's form, as LineGrid renders it, so a row
// save can return just #grid-row-<no> for its hx-target="this" swap.
templ LineGridRowForm(r LineGridRow) {
	<form
		id={ lineGridID(r.No) }
		class="linegrid-form"
		hx-post={ r.PostURL }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
		hx-include="#doc-version"
		hx-sync="#line-editor:queue all"
	>
		<span class="linegrid-no"><span class="visually-hidden">Line</span>{ strconv.Itoa(r.No) }</span>
		for _, c := range r.Cells {
			@c.Input
		}
		<span class="num linegrid-amount"><span class="visually-hidden">Amount</span>{ r.Amount }</span>
	</form>
}

// LineGridError is the message of a grid cell with no field around it, in
// the field's own markup; id is the cell's grid-<no>-<field>.
templ LineGridError(id, message string) {
	if message != "" {
		@fieldMsg(id, message, "", false)
	}
}

// versionInput is a move form's hidden version, when there is one; id
// lets LineGridVersions replace it.
templ versionInput(version, id string) {
	if version != "" {
		if id != "" {
			<input type="hidden" id={ id } name="version" value={ version }/>
		} else {
			<input type="hidden" name="version" value={ version }/>
		}
	}
}

// LineGridVersions are out-of-band swaps giving every grid move form the
// version a row save produced. A form's own inputs win over hx-include in
// htmx 2.0.11 (getInputValues), so the move forms' rendered version must be
// replaced, or a move after a row save is refused as stale (CD-94, CD-95).
templ LineGridVersions(rows []LineGridRow, version string) {
	for _, r := range rows {
		if r.MoveUpURL != "" {
			<input type="hidden" id={ moveVersionID(r.No, "up") } name="version" value={ version } hx-swap-oob="true"/>
		}
		if r.MoveDownURL != "" {
			<input type="hidden" id={ moveVersionID(r.No, "down") } name="version" value={ version } hx-swap-oob="true"/>
		}
	}
}

// lineActionsProps are one line's action URLs; an empty one hides its
// action.
type lineActionsProps struct {
	No                                           int
	ChangeURL, RemoveURL, MoveUpURL, MoveDownURL string
	Version                                      string
}

// lineActions are a line's Change and Remove links and its move forms,
// posting Version (CD-94), for a card and a display grid row (CD-313).
templ lineActions(class string, a lineActionsProps) {
	<div class={ class }>
		if a.ChangeURL != "" {
			@Button(ButtonProps{Label: "Change", AriaLabel: lineAria("Change", a.No), Href: a.ChangeURL, Variant: Ghost})
		}
		if a.RemoveURL != "" {
			@Button(ButtonProps{Label: "Remove", AriaLabel: lineAria("Remove", a.No), Href: a.RemoveURL, Variant: Ghost})
		}
		if a.MoveUpURL != "" {
			@Form(FormProps{Action: a.MoveUpURL}) {
				@versionInput(a.Version, "")
				@Button(ButtonProps{Label: "Move up", AriaLabel: lineAria("Move up", a.No), Icon: "arrow-up", Variant: Ghost})
			}
		}
		if a.MoveDownURL != "" {
			@Form(FormProps{Action: a.MoveDownURL}) {
				@versionInput(a.Version, "")
				@Button(ButtonProps{Label: "Move down", AriaLabel: lineAria("Move down", a.No), Icon: "arrow-down", Variant: Ghost})
			}
		}
	</div>
}
