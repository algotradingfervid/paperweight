package components

import "github.com/vardhan/internaltools/internal/ui/icons"

// CardProps is a section card (UI v2 §5.5 item 1). Icon names the glyph in
// the tile beside the heading and Description is the one line under it;
// Change, when set, is its "Change" action, a plain link; Action, used when
// Change is nil, is a ghost button in the same place (UI v2 §5.6 check
// cards). FocusHeading gives the heading tabindex="-1" and
// data-focus-heading, which app.js focuses after the htmx swap that brings
// the card (CD-358).
type CardProps struct {
	Title, Icon, Description string
	Change                   *Link
	Action                   *ButtonProps
	FocusHeading             bool
}

// Card is a titled section; change, when set, is its "Change" action.
templ Card(title string, change *Link) {
	@CardWith(CardProps{Title: title, Change: change}) {
		{ children... }
	}
}

// CardWith is the card p describes around its children.
templ CardWith(p CardProps) {
	<section class="card card-border">
		<div class="card-body">
			if p.Title != "" || p.Change != nil || p.Action != nil {
				<div class="card-head">
					if p.Icon != "" || p.Description != "" {
						<div class="card-lead">
							if p.Icon != "" {
								<span class="card-icon" aria-hidden="true">
									@icons.Icon(p.Icon)
								</span>
							}
							<div class="card-titles">
								@cardTitle(p)
								if p.Description != "" {
									<p class="card-desc">{ p.Description }</p>
								}
							</div>
						</div>
					} else {
						@cardTitle(p)
					}
					if p.Change != nil {
						<a href={ templ.SafeURL(p.Change.Href) }>
							{ p.Change.Label }
							if p.Title != "" {
								<span class="visually-hidden">{ p.Title }</span>
							}
						</a>
					} else if p.Action != nil {
						@Button(ghost(*p.Action))
					}
				</div>
			}
			{ children... }
		</div>
	</section>
}

templ cardTitle(p CardProps) {
	if p.Title != "" {
		if p.FocusHeading {
			<h2 class="card-title" tabindex="-1" data-focus-heading>{ p.Title }</h2>
		} else {
			<h2 class="card-title">{ p.Title }</h2>
		}
	}
}

// ghost is b as a ghost button.
func ghost(b ButtonProps) ButtonProps {
	b.Variant = Ghost
	return b
}
