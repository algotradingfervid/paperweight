package components

import (
	"fmt"
	"slices"
	"strconv"
	"strings"
	"unicode/utf8"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// tileMaxChars is the longest Tiles label that shares its row, the same 12
// as docscreen's maxSegment (CD-353). A chosen half-width tile is 112 px wide
// at 320 and 132 at 360, before its padding and check, so two short words
// this long wrap whole. It counts the label; tileMaxWord counts its words.
const tileMaxChars = 12

// tileMaxWord is the longest word that shares its row. A chosen half tile at
// 320 px has 76 px for its text: 112, less 16 of padding and 20 of check and
// gap. Measured there in Inter 600 at 16 px, Workmen and Lodging (7 characters)
// are 74.6 and 62.8 and stay whole; Workshop (8) is 79.3 and splits, as do
// Stationery, Refreshments and Mobilisation. Characters differ in width, so
// this errs short: Hardware (8) would fit, and a wide tile does no harm. A few
// words of 7 heavy in m and w, such as Command at 79.3, still split, but only
// 6 would stop them, and that widens Lodging. Words end at spaces: Chrome
// breaks after a hyphen, not a slash, and splits Food/Travel in a half tile,
// so both count as one word and go wide, with 192 px for the text.
const tileMaxWord = 7

// tileWide reports whether o takes a Tiles grid's full row.
func tileWide(o Option) bool {
	if utf8.RuneCountInString(o.Label) > tileMaxChars {
		return true
	}
	for word := range strings.SplitSeq(o.Label, " ") {
		if utf8.RuneCountInString(word) > tileMaxWord {
			return true
		}
	}
	return false
}

// tileOrder is opts as Tiles draws them: those that share a row, then the
// wide ones, each in the order given, in a new slice. A grid can't close the
// gap before a full-row tile without drawing out of DOM order, so the order
// is settled here, for every caller.
func tileOrder(opts []Option) []Option {
	out := make([]Option, 0, len(opts))
	for _, wide := range []bool{false, true} {
		for _, o := range opts {
			if tileWide(o) == wide {
				out = append(out, o)
			}
		}
	}
	return out
}

// optionID gives the first option the field's own id, so error links reach it.
func optionID(p FieldProps, i int) string {
	if i == 0 {
		return p.ID
	}
	return p.ID + "-" + strconv.Itoa(i)
}

// choiceAttrs are controlAttrs for option i of a radio or checkbox group.
func choiceAttrs(p FieldProps, i int, class string) templ.Attributes {
	a := controlAttrs(p, class)
	a["id"] = optionID(p, i)
	return a
}

// Radios is a radio group; each whole row is the target.
templ Radios(p FieldProps, opts []Option) {
	@choiceGroup(p) {
		for i, o := range opts {
			<label class="field__choice">
				<input type="radio" value={ o.Value } checked?={ o.Value == p.Value } { choiceAttrs(p, i, "radio")... }/>
				@optionText(o)
			</label>
		}
	}
}

// Checkboxes is a checkbox group; checked holds the ticked values.
templ Checkboxes(p FieldProps, opts []Option, checked []string) {
	@choiceGroup(p) {
		for i, o := range opts {
			<label class="field__choice">
				<input type="checkbox" value={ o.Value } checked?={ slices.Contains(checked, o.Value) } { choiceAttrs(p, i, "checkbox")... }/>
				@optionText(o)
			</label>
		}
	}
}

// Segmented is a radio group shown as a segmented control: a sunken track,
// the chosen option a raised thumb with a check icon (UI v2 §5.5 item 8).
templ Segmented(p FieldProps, opts []Option) {
	@choiceGroup(p) {
		<div class="segmented">
			@segments(p, opts, false)
		</div>
	}
}

// Tiles is Segmented in a two-column grid, for options with longer words
// (UI v2 §5.5 item 8, N7); a label over tileMaxChars, or with a word over
// tileMaxWord, takes the full row, and those are drawn last (tileOrder).
templ Tiles(p FieldProps, opts []Option) {
	@choiceGroup(p) {
		<div class="segmented segmented--tiles">
			@segments(p, tileOrder(opts), true)
		</div>
	}
}

templ segments(p FieldProps, opts []Option, tiles bool) {
	for i, o := range opts {
		<label
			if tiles && tileWide(o) {
				class="segmented__wide"
			}
		>
			<input type="radio" value={ o.Value } checked?={ o.Value == p.Value } { choiceAttrs(p, i, "input-overlay")... }/>
			<span class="segmented__text">
				<span class="segmented__check">
					@icons.Icon("check")
				</span>
				{ o.Label }
			</span>
		</label>
	}
}

templ Select(p FieldProps, opts []Option) {
	@field(p) {
		<select { controlAttrs(p, "select field__input")... }>
			for _, o := range opts {
				<option value={ o.Value } selected?={ o.Value == p.Value }>{ o.Label }</option>
			}
		</select>
	}
}

templ optionText(o Option) {
	{{ checkBar(o) }}
	<span class="field__choice-text">
		{ o.Label }
		if o.Hint != "" {
			<span class="field__hint">{ o.Hint }</span>
		}
		@optionLines(o)
	</span>
}

// optionLines are o's Lines, its LineIcon first in the first one and its
// Bar first in the last one.
templ optionLines(o Option) {
	for i, line := range o.Lines {
		<span class="field__hint choice-line">
			if o.LineIcon != "" && i == 0 {
				@icons.Icon(o.LineIcon)
			}
			if o.Bar != nil && i == len(o.Lines)-1 {
				<progress class="choice-meter" value={ strconv.Itoa(o.Bar.Value) } max={ strconv.Itoa(o.Bar.Max) } aria-hidden="true"></progress>
			}
			{ line }
		</span>
	}
}

// checkBar panics on a Bar an option row can't draw (see Meter), and on a
// LineIcon without a line.
func checkBar(o Option) {
	if o.LineIcon != "" && len(o.Lines) == 0 {
		panic(fmt.Sprintf("components: option %q: icon %q needs a line", o.Value, o.LineIcon))
	}
	if o.Bar == nil {
		return
	}
	if b := *o.Bar; b.Max <= 0 || b.Value < 0 || b.Value > b.Max || len(o.Lines) == 0 {
		panic(fmt.Sprintf("components: option %q: bar %d of %d needs Max above 0, Value from 0 to Max and a line", o.Value, b.Value, b.Max))
	}
}
