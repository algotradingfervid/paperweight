package components

import "github.com/vardhan/internaltools/internal/ui/icons"

// SuccessProps is the success block after an action (UI v2 §5.13 item 2,
// N14, A-25): Title its heading from the lifecycle, Message the line about
// what happened and who it went to, and Links its follow-ups, which the
// caller offers only as rights allow.
type SuccessProps struct {
	Title   string
	Message string
	Links   []Link
}

// SuccessBlock is the block: the drawn tick (still under reduced motion), the
// text and a button per follow-up, read out once as a status.
templ SuccessBlock(p SuccessProps) {
	<div class="success-block" role="status">
		@CardWith(CardProps{}) {
			<div class="success-block__head">
				<span class="success-block__tick" aria-hidden="true">
					@icons.Icon("circle-check")
				</span>
				<div class="success-block__words">
					if p.Title != "" {
						<h2 class="success-block__title">{ p.Title }</h2>
					}
					<p class="success-block__text">{ p.Message }</p>
				</div>
			</div>
			if len(p.Links) > 0 {
				<div class="success-block__links">
					for _, l := range p.Links {
						@Button(ButtonProps{Label: l.Label, Href: l.Href, Variant: Secondary})
					}
				</div>
			}
		}
	</div>
}
