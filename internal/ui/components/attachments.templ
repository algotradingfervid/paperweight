package components

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// Attachments lists stored files: images as lazy thumbnails, HEIC as a
// download link (browsers can't show it), others as a file chip. Each item
// shows who uploaded it and when, and, when RemoveURL is set, "Remove", which
// opens the file's confirm. A Compact item is a ~4rem thumbnail with
// "name · size" on one line and no uploader (CD-326 (6)). An item with
// Attached is a 64 × 80 tile: the thumbnail or file icon, then the name,
// "size · uploaded time" and those words beside a check (UI v2 §5.9).
templ Attachments(items []Attachment) {
	@attachmentItems(items, "", "")
}

// attachmentItems is Attachments whose Remove confirms swap target (Form's
// default when empty) and whose thumbnails' alt is alt (the file's name when
// empty).
templ attachmentItems(items []Attachment, target, alt string) {
	<ul class="attachments">
		for _, a := range items {
			<li
				if a.Attached != "" {
					class="attachments-tile"
				}
				if a.Compact && a.Attached == "" {
					class="attachments-compact"
				}
			>
				@attachmentLink(a, orDefault(alt, a.Name))
				if a.Attached != "" {
					<div class="attachments__tile-text">
						<p class="attachments__name">{ a.Name }</p>
						<p class="attachments__meta">{ tileMeta(a) }</p>
						<p class="attachments__attached">
							@icons.Icon("circle-check")
							<span>{ a.Attached }</span>
						</p>
					</div>
				} else if a.Compact {
					<p class="attachments__meta">{ compactLine(a) }</p>
				} else {
					if a.Kind == "image" || a.Kind == "heic" {
						<p class="attachments__name">{ a.Name }</p>
					}
					// Spaces keep the name, size and uploader apart in the page text.
					{ " " }
					<p class="attachments__meta">{ a.Size }</p>
					{ " " }
					<p class="attachments__meta">{ a.UploadedBy + " · " + a.UploadedAt }</p>
				}
				if a.RemoveURL != "" {
					@Button(ButtonProps{Label: "Remove", AriaLabel: "Remove " + a.Name, Type: "button", Variant: Secondary, Attrs: templ.Attributes{"data-open-dialog": removeDialogID(a.ID)}})
					@removeConfirm(a, target)
				}
			</li>
		}
	</ul>
}

// attachmentLink is file a's link: an image as a lazy thumbnail with alt,
// HEIC as a download chip (browsers can't show it), others as a file chip.
templ attachmentLink(a Attachment, alt string) {
	switch a.Kind {
		case "image":
			<a class="attachments__thumb" href={ templ.URL(a.URL) }>
				<img loading="lazy" alt={ alt } src={ a.URL }/>
			</a>
		case "heic":
			<a class="attachments__chip" href={ templ.URL(a.URL) } download>
				@icons.Icon("file")
				<span>HEIC image, opens as download</span>
			</a>
		default:
			<a class="attachments__chip" href={ templ.URL(a.URL) }>
				@icons.Icon("file-text")
				<span>{ a.Name }</span>
			</a>
	}
}

// tileMeta is an attached-file tile's "size · uploaded time"; a HEIC file adds
// that it downloads, as browsers can't show it.
func tileMeta(a Attachment) string {
	line := a.Size + " · uploaded " + a.UploadedAt
	if a.Kind == "heic" {
		line += " · opens as download"
	}
	return line
}

// compactLine is a compact item's one line: "name · size", or the size
// alone beside a file chip, which shows the name.
func compactLine(a Attachment) string {
	if a.Kind == "image" || a.Kind == "heic" {
		return a.Name + " · " + a.Size
	}
	return a.Size
}

// removeDialogID is the id of file id's Remove confirm.
func removeDialogID(id int64) string { return "remove-file-" + strconv.FormatInt(id, 10) }

// removeConfirm asks before file a is removed (design-system §8.5): its form
// is the only one that posts the removal.
templ removeConfirm(a Attachment, target string) {
	@Dialog(removeDialogID(a.ID), "Remove this file?") {
		<p>{ a.Name + " will be removed from this document. You can attach it again later." }</p>
		@Form(FormProps{Action: a.RemoveURL, HX: true, Target: target}) {
			<div class="cluster">
				@Button(ButtonProps{Label: "Remove file", Busy: "Removing…", Variant: Danger})
				@Button(ButtonProps{Label: "Keep file", Type: "button", Variant: Secondary, Attrs: templ.Attributes{"data-close-dialog": true}})
			</div>
		}
	}
}
