package components

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// DataList is one markup for every list (design-system §8.1): cards on
// phones, aligned rows with a header from 48rem (container query). Each
// card is one link; every value carries a hidden label.
func DataList(p DataListProps) templ.Component {
	if len(p.Rows) == 0 {
		if p.Empty == nil {
			return templ.NopComponent
		}
		return p.Empty
	}
	return dataList(p, listLayoutOf(p.Columns))
}

templ dataList(p DataListProps, l listLayout) {
	<div
		class="datalist"
		data-cols={ strconv.Itoa(l.tracks()) }
		if l.nowrapTracks() != "" {
			data-nowrap={ l.nowrapTracks() }
		}
		if l.wideTracks() != "" {
			data-wide={ l.wideTracks() }
		}
		if l.labelTracks() != "" {
			data-label={ l.labelTracks() }
		}
		if l.state != nil {
			data-state={ strconv.Itoa(l.tracks()) }
		}
	>
		<div class="datalist-head" aria-hidden="true">
			if l.title != nil {
				@listHead(*l.title)
			} else {
				<span></span>
			}
			if l.figure != nil {
				@listHead(*l.figure)
			}
			for _, c := range l.meta {
				@listHead(c)
			}
			if l.state != nil {
				@listHead(*l.state)
			}
		</div>
		<ul class="list datalist-rows" role="list" aria-label={ p.Label }>
			for _, r := range p.Rows {
				<li>
					@listCard(l, r)
				</li>
			}
		</ul>
	</div>
}

templ listHead(c Column) {
	<span
		if c.Num {
			class="num"
		}
		if c.Priority >= PLow {
			data-priority="low"
		}
	>{ c.Label }</span>
}

templ listCard(l listLayout, r Row) {
	<a
		if r.Tone == ToneWarning {
			class="datalist-link datalist-link--warning"
		} else {
			class="datalist-link"
		}
		href={ templ.URL(r.Href) }
	>
		<div class="datalist-r1">
			if l.title != nil {
				@listCell(cardCell{Column: *l.title, title: true}) {
					if r.Code != "" {
						<span class="datalist-code">{ r.Code }</span>{ " " }
					}
					{ l.titleText(r) }
				}
			} else {
				<p class="datalist-cell datalist-title">{ r.Title }</p>
			}
			if l.figure != nil {
				@listCell(cardCell{Column: *l.figure}) {
					{ r.Values[l.figure.Key] }
				}
			}
		</div>
		if r.Party != "" {
			<p class="datalist-cell datalist-party">{ r.Party }</p>
		} else if c := l.listSecond(r); c != nil {
			<div class="datalist-r2">
				@listCell(cardCell{Column: *c}) {
					{ r.Values[c.Key] }
				}
			</div>
		}
		<div class="datalist-r3">
			for _, c := range l.thirdCells(r) {
				if c.state {
					@listCell(c) {
						if !c.blank {
							@StateBadgeLabel(r.State, r.StateLabel)
						}
					}
				} else {
					@listCell(c) {
						{ r.Values[c.Key] }
					}
				}
			}
		</div>
		<span class="datalist-go" aria-hidden="true">
			@icons.Icon("chevron-right")
		</span>
	</a>
}

// listCell is one labelled value. On cards a blank value is hidden (it keeps
// its track in aligned rows), sep ends the value with " · " so a wrapped line
// never starts with one, and sepLow hides that separator with the
// low-priority values.
templ listCell(c cardCell) {
	<dl
		class={ listCellClass(c.Column, c.title), templ.KV("datalist-nowrap", c.NoWrap), templ.KV("datalist-wide", c.Wide), templ.KV("datalist-blank", c.blank) }
		if c.Priority >= PLow {
			data-priority="low"
		}
	>
		<dt class="visually-hidden">{ c.Label }</dt>
		<dd>
			{ children... }
			if c.sep {
				<span
					class="datalist-sep"
					aria-hidden="true"
					if c.sepLow {
						data-priority="low"
					}
				>{ listSep }</span>
			}
		</dd>
	</dl>
}
