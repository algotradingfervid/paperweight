package components

import "github.com/vardhan/internaltools/internal/ui/icons"

// Attachment is one stored file as shown under FileUpload and on document
// pages. Kind is "image", "heic", "pdf" or "other".
type Attachment struct {
	ID                                                       int64
	Name, Size, UploadedBy, UploadedAt, URL, RemoveURL, Kind string
}

// UploadProps describes a FileUpload. Action receives one "file" part per
// request; its response replaces Target (default the element with id ID), and
// so does a Remove confirm's.
// Accept is the Choose file control's file types (default images and PDFs).
// NoCamera leaves out "Take photo", for files a camera can't make.
type UploadProps struct {
	ID, Label, Action, Hint, Error string
	Accept, Target                 string
	NoCamera                       bool
	Files                          []Attachment
}

// UploadInputID is the id of the Choose file input of the FileUpload with id
// id: the place an ErrorSummary link goes.
func UploadInputID(id string) string { return id + "-file" }

// FileUpload states the limits first, then offers "Take photo" (rear camera
// on phones) and "Choose file". Choosing a file posts it at once and disables
// both inputs; upload.js moves the progress bar, puts the status line's
// data-busy text in it and copies the template's error markup into the
// message region for a refusal (data-dropped when no answer came).
templ FileUpload(p UploadProps) {
	<div id={ p.ID } class="upload">
		@choiceGroup(FieldProps{ID: p.ID, Label: p.Label, Hint: orDefault(p.Hint, "JPG, PNG, HEIC or PDF, up to 10 MB"), Error: p.Error}) {
			<div class="upload__controls">
				if !p.NoCamera {
					@uploadForm(p, true)
				}
				@uploadForm(p, false)
			</div>
		}
		<progress class="progress upload__progress" max="100" value="0" hidden></progress>
		<p id={ p.ID + "-status" } role="status" data-busy="Uploading…" data-dropped="The upload didn't finish. Check your connection and try again."></p>
		<template data-upload-msg>
			@icons.Icon("alert-circle")
			<span></span>
		</template>
		if len(p.Files) > 0 {
			@attachmentItems(p.Files, orDefault(p.Target, "#"+p.ID))
		}
	</div>
}

// uploadForm is one control in its own form, so the other control's empty
// input never sends a second "file" part.
templ uploadForm(p UploadProps, camera bool) {
	@Form(FormProps{Action: p.Action, HX: true, Multipart: true, Target: orDefault(p.Target, "#"+p.ID), Trigger: "change", DisabledElt: "#" + p.ID + " input[type=file]"}) {
		<label class={ buttonClass(Secondary) + " upload__button" }>
			if camera {
				@icons.Icon("camera")
				<span>Take photo</span>
				<input
					type="file"
					name="file"
					accept="image/*"
					capture="environment"
					class="input-overlay"
					aria-describedby={ p.ID + "-hint " + p.ID + "-msg" }
					if p.Error != "" {
						aria-invalid="true"
					}
				/>
			} else {
				@icons.Icon("upload")
				<span>Choose file</span>
				<input
					id={ UploadInputID(p.ID) }
					type="file"
					name="file"
					accept={ orDefault(p.Accept, "image/*,application/pdf") }
					class="input-overlay"
					aria-describedby={ p.ID + "-hint " + p.ID + "-msg" }
					if p.Error != "" {
						aria-invalid="true"
					}
				/>
			}
		</label>
	}
}
