package components

import (
	"net/http"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// problemNext is the next-step line under every 403 and 404 (UI v2 §5.14).
const problemNext = "If someone sent you this link, ask them to check it, or ask your administrator for access."

// problemLook is status's icon and heading: 403 says access, anything else
// reads as a 404.
func problemLook(status int) (icon, heading string) {
	if status == http.StatusForbidden {
		return "shield-alert", "You don't have access to this"
	}
	return "file-question", "We can't open this page"
}

// ProblemPage is the 403 or 404 page body: an icon, a plain heading (the
// page's h1), message (the kernel's text, exactly), the next step, and Go to
// Home and Search (UI v2 §5.14, A-30). It names nothing beyond message.
templ ProblemPage(status int, message string) {
	{{ icon, heading := problemLook(status) }}
	<section class="problem" aria-labelledby="page-title">
		<div class="problem-icon" aria-hidden="true">
			@icons.Icon(icon)
		</div>
		<h1 id="page-title" tabindex="-1">{ heading }</h1>
		<p class="problem-message">{ message }</p>
		<p class="problem-next">{ problemNext }</p>
		<div class="problem-actions">
			@Button(ButtonProps{Label: "Go to Home", Href: "/", Icon: "house", Variant: Primary})
			@Button(ButtonProps{Label: "Search", Href: "/search", Icon: "search", Variant: Secondary})
		</div>
	</section>
}
