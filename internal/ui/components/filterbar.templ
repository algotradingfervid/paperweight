package components

import (
	"context"
	"slices"
	"strconv"
	"strings"

	"github.com/vardhan/internaltools/internal/ui"
	"github.com/vardhan/internaltools/internal/ui/icons"
)

// Chip is one active filter; RemoveURL is the same page without it.
type Chip struct{ Label, RemoveURL string }

// QuickChip is one quick pick link under the search (UI v2 §5.12): All,
// then a DocType's states. Count is shown after the label; Current marks the
// one the page shows.
type QuickChip struct {
	Label, Href, Count string
	Current            bool
}

// FilterGroup is one set of ticks in the Filters panel: a checkbox per
// option, named Name; Checked holds the ticked values.
type FilterGroup struct {
	Label, Name string
	Options     []Option
	Checked     []string
}

// Param is one query parameter the bar carries through a search or sort.
type Param struct{ Name, Value string }

// FilterBarProps describes the search, sort and filter bar above a result set.
// With no SearchLabel the bar has no search box; with a Placeholder its label
// is for screen readers only. Panel groups go in the Filters disclosure, with
// Active as its count; Export then shows there on phones.
// Autofocus focuses the search box on load.
type FilterBarProps struct {
	Action, Search, SearchLabel, Sort string
	Placeholder                       string
	Sorts                             []Option
	Chips                             []Chip
	Quick                             []QuickChip
	Panel                             []FilterGroup
	Active                            int
	FilterURL, ClearURL, Count        string
	New, Export                       *Link
	Keep                              []Param // hidden inputs, e.g. the active filters
	Links                             []Link  // plain GET links, e.g. one per filter value
	Autofocus                         bool
}

// filterTrigger is the form's hx-trigger. With a panel only the search and
// the sort send at once: a tick waits for Show results, so the panel stays
// open while the user picks.
func filterTrigger(p FilterBarProps) string {
	if len(p.Panel) == 0 {
		return "change, submit"
	}
	t := []string{"submit"}
	if p.SearchLabel != "" {
		t = append(t, "change from:#filter-q")
	}
	if len(p.Sorts) > 0 {
		t = append(t, "change from:#filter-sort")
	}
	return strings.Join(t, ", ")
}

// newInNav reports whether the shell's New sheet offers l, so the bottom nav
// holds it on phones (CD-366).
func newInNav(ctx context.Context, l *Link) bool {
	return slices.ContainsFunc(ui.ShellFrom(ctx).New, func(n ui.NavItem) bool { return n.Href == l.Href })
}

// FilterBar is a GET form, so a filtered URL can be shared.
templ FilterBar(p FilterBarProps) {
	<form class="filterbar" method="get" action={ templ.SafeURL(p.Action) } hx-get={ p.Action } hx-target="#main" hx-swap="outerHTML" hx-push-url="true" hx-trigger={ filterTrigger(p) }
		if p.SearchLabel != "" {
			role="search"
		}
	>
		for _, k := range p.Keep {
			<input type="hidden" name={ k.Name } value={ k.Value }/>
		}
		if p.SearchLabel != "" || p.FilterURL != "" || len(p.Links) > 0 || len(p.Panel) > 0 {
			<div class="filterbar-row">
				if p.SearchLabel != "" {
					<div class="filterbar-search">
						<label for="filter-q" class={ templ.KV("visually-hidden", p.Placeholder != "") }>{ p.SearchLabel }</label>
						<div class="filterbar-box">
							@icons.Icon("search")
							<input
								id="filter-q"
								class="input"
								type="search"
								name="q"
								value={ p.Search }
								autofocus?={ p.Autofocus }
								if p.Placeholder != "" {
									placeholder={ p.Placeholder }
								}
							/>
						</div>
					</div>
				}
				if p.FilterURL != "" {
					<a class="btn btn-outline" href={ templ.SafeURL(p.FilterURL) }>
						@icons.Icon("filter")
						Filter
					</a>
				}
				if len(p.Panel) > 0 {
					@filterPanel(p)
				}
				for _, l := range p.Links {
					@Button(ButtonProps{Label: l.Label, Href: l.Href})
				}
			</div>
		}
		if len(p.Quick) > 0 {
			<ul class="filterbar-chips" aria-label="Quick filters">
				for _, c := range p.Quick {
					<li>
						<a
							class="badge chip chip-quick"
							href={ templ.SafeURL(c.Href) }
							if c.Current {
								aria-current="true"
							}
						>
							{ c.Label }
							if c.Count != "" {
								<span class="chip-count">{ c.Count }</span>
							}
						</a>
					</li>
				}
			</ul>
		}
		if len(p.Chips) > 0 {
			<ul class="filterbar-chips" aria-label="Active filters">
				for _, c := range p.Chips {
					<li>
						<a class="badge chip" href={ templ.SafeURL(c.RemoveURL) }>
							@icons.Icon("list-filter")
							{ c.Label }
							@icons.Icon("x")
							<span class="visually-hidden">Remove filter</span>
						</a>
					</li>
				}
				<li><a class="btn btn-ghost" href={ templ.SafeURL(p.ClearURL) }>Clear all</a></li>
			</ul>
		}
		if p.Count != "" || len(p.Sorts) > 0 || p.New != nil || p.Export != nil {
			<div class="filterbar-row filterbar-result">
				if p.Count != "" {
					<p class="filterbar-count">{ p.Count }</p>
				}
				if len(p.Sorts) > 0 {
					<div class="filterbar-sort">
						<label for="filter-sort" class="visually-hidden">Sort by</label>
						@icons.Icon("arrow-up-down")
						<select id="filter-sort" class="select" name="sort">
							for _, o := range p.Sorts {
								<option value={ o.Value } selected?={ o.Value == p.Sort }>{ o.Label }</option>
							}
						</select>
					</div>
				}
				if p.Export != nil {
					<a class={ "btn btn-outline", templ.KV("filterbar-wide", len(p.Panel) > 0) } href={ templ.SafeURL(p.Export.Href) }>
						@icons.Icon("download")
						{ p.Export.Label }
					</a>
				}
				if p.New != nil {
					<a class={ "btn btn-primary", templ.KV("filterbar-wide", newInNav(ctx, p.New)) } href={ templ.SafeURL(p.New.Href) }>
						@icons.Icon("plus")
						{ p.New.Label }
					</a>
				}
			</div>
		}
	</form>
}

// filterPanel is the Filters disclosure: a button with the active count,
// then each group's ticks, Show results and, on phones, Export (UI v2
// §5.12). It sits in the bar's form, so without JavaScript Show results is a
// plain GET.
templ filterPanel(p FilterBarProps) {
	<details class="filterbar-panel">
		<summary class="btn btn-outline">
			@icons.Icon("list-filter")
			Filters
			if p.Active > 0 {
				<span class="chip-count">{ strconv.Itoa(p.Active) }<span class="visually-hidden">{ " on" }</span></span>
			}
		</summary>
		<div class="filterbar-sheet">
			for i, g := range p.Panel {
				@Checkboxes(FieldProps{ID: "filter-g" + strconv.Itoa(i), Name: g.Name, Label: g.Label}, g.Options, g.Checked)
			}
			@Button(ButtonProps{Label: "Show results", Busy: "Finding…", Variant: Primary})
			if p.Export != nil {
				<div class="filterbar-narrow">
					@Button(ButtonProps{Label: p.Export.Label, Icon: "download", Href: p.Export.Href})
				</div>
			}
		</div>
	</details>
}
