package components

import "github.com/vardhan/internaltools/internal/ui"

// inForm points button b at the form the bar sits outside of, when there is one.
func inForm(b ButtonProps, form string) ButtonProps {
	if form == "" || b.Href != "" {
		return b
	}
	attrs := templ.Attributes{"form": form}
	for k, v := range b.Attrs {
		attrs[k] = v
	}
	b.Attrs = attrs
	return b
}

// ActionBar holds a screen's actions: sticky on phones, inline from 48rem.
// A note replaces the buttons; with nothing to show it renders nothing.
templ ActionBar(p ActionBarProps) {
	if p.Note != "" {
		<div class="actionbar">
			<p class="actionbar-note">{ p.Note }</p>
		</div>
	} else if p.Primary != nil || p.Secondary != nil {
		<div class="actionbar">
			// The primary comes first, so Enter in a field submits it (the
			// form's default button is its first submit in tree order).
			if p.Primary != nil {
				@Button(inForm(*p.Primary, p.Form))
			}
			if p.Secondary != nil {
				@Button(inForm(*p.Secondary, p.Form))
			}
		</div>
	}
	if p.FinishLater && p.Note == "" {
		<div class="actionbar-later">
			@Button(inForm(ButtonProps{Label: "Save and finish later", Name: "nav", Value: "finish", Variant: Ghost}, p.Form))
		</div>
	}
}

// EnterSubmit is an empty, unseen copy of primary p at the start of a form,
// so Enter presses the primary and never a body's own submit (CD-286 R4).
// It posts p's Name and Value and carries p's Attrs except form; it is
// sized 0×0 by enter-submit, never display:none, so it stays the default.
templ EnterSubmit(p ButtonProps) {
	<button type="submit" class="enter-submit" tabindex="-1" aria-hidden="true"
		if p.Name != "" {
			name={ p.Name } value={ p.Value }
		}
		{ withoutForm(p.Attrs)... }
	></button>
}

// withoutForm is attrs without its form attribute.
func withoutForm(attrs templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range attrs {
		if k != "form" {
			out[k] = v
		}
	}
	return out
}

// MoreActions lists the secondary actions; a POST action is a one-button form.
templ MoreActions(items []MoreAction) {
	if len(items) > 0 {
		<section class="more-actions" aria-labelledby="more-actions-title">
			<h2 id="more-actions-title">More actions</h2>
			<ul class="more-actions-items">
				for _, it := range items {
					<li>
						if it.Post {
							<form method="post" action={ templ.SafeURL(it.Href) }>
								<input type="hidden" name="csrf_token" value={ ui.ShellFrom(ctx).CSRF }/>
								for _, h := range it.Hidden {
									<input type="hidden" name={ h.Name } value={ h.Value }/>
								}
								@Button(ButtonProps{Label: it.Label, Busy: it.Label + "…", Variant: moreVariant(it.Danger)})
							</form>
						} else if it.NewTab {
							@Button(ButtonProps{Label: it.Label, AriaLabel: it.Label + " (opens in a new tab)", Href: it.Href, Variant: moreVariant(it.Danger), Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}})
						} else {
							@Button(ButtonProps{Label: it.Label, Href: it.Href, Variant: moreVariant(it.Danger)})
						}
					</li>
				}
			</ul>
		</section>
	}
}

func moreVariant(danger bool) Variant {
	if danger {
		return Danger
	}
	return Ghost
}
