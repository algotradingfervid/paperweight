package components

import "github.com/vardhan/internaltools/internal/ui"

// moreActionsTitle names the More actions list, its sheet and its opener.
const moreActionsTitle = "More actions"

// inForm points button b at the form the bar sits outside of, when there is one.
func inForm(b ButtonProps, form string) ButtonProps {
	if form == "" || b.Href != "" {
		return b
	}
	attrs := templ.Attributes{"form": form}
	for k, v := range b.Attrs {
		attrs[k] = v
	}
	b.Attrs = attrs
	return b
}

// moreOpener is the bar's ellipsis for More actions (UI v2 §5.13 item 7). In
// a bar with no other button it has its word as well.
func moreOpener(p ActionBarProps) ButtonProps {
	b := ButtonProps{AriaLabel: moreActionsTitle, Icon: "ellipsis", Type: "button", Variant: Secondary, Attrs: templ.Attributes{"data-open-dialog": p.MoreSheet, "aria-haspopup": "dialog"}}
	if p.Primary == nil && p.Secondary == nil {
		b.Label = moreActionsTitle
	}
	return b
}

// ActionBar holds a screen's actions: sticky on phones, inline from 48rem. A
// note sits above the buttons; with nothing to show it renders nothing.
// p.Summary is a row above the buttons (A-22). "Save and finish later"
// follows the bar in the page flow, after the primary in tree order (CD-378).
templ ActionBar(p ActionBarProps) {
	if p.Note != "" || p.Primary != nil || p.Secondary != nil || p.MoreSheet != "" {
		<div class="actionbar">
			if p.Note != "" {
				<p class="actionbar-note">{ p.Note }</p>
			}
			if p.Summary != nil {
				<div class="actionbar-summary">
					@p.Summary
				</div>
			}
			// The primary comes first, so Enter in a field submits it (the
			// form's default button is its first submit in tree order).
			if p.Primary != nil {
				@Button(inForm(*p.Primary, p.Form))
			}
			if p.Secondary != nil {
				@Button(inForm(*p.Secondary, p.Form))
			}
			if p.MoreSheet != "" {
				@Button(moreOpener(p))
			}
		</div>
	}
	if p.FinishLater && p.Note == "" {
		<div class="actionbar-later">
			@Button(inForm(ButtonProps{Label: "Save and finish later", Name: "nav", Value: "finish", Variant: Ghost}, p.Form))
		</div>
	}
}

// BarTotalLine is an ActionBar Summary on one line at every width (CD-378 (2)):
// "{count} · {label} {value}", only the count without a label. Below 25rem
// the label is visually hidden; oob makes it an out-of-band swap of t.ID.
templ BarTotalLine(t BarTotal, oob bool) {
	<span
		id={ t.ID }
		class="actionbar-total"
		if oob {
			hx-swap-oob="true"
		}
	>
		<span>{ t.Count }</span>
		if t.Label != "" {
			{ " " }
			<span>·</span>
			{ " " }
			<span class="actionbar-total-label">{ t.Label }</span>
			{ " " }
			<span>{ t.Value }</span>
		}
	</span>
}

// EnterSubmit is an empty, unseen copy of primary p at the start of a form,
// so Enter presses the primary and never a body's own submit (CD-286 R4).
// It posts p's Name and Value and carries p's Attrs except form; it is
// sized 0×0 by enter-submit, never display:none, so it stays the default.
templ EnterSubmit(p ButtonProps) {
	<button type="submit" class="enter-submit" tabindex="-1" aria-hidden="true"
		if p.Name != "" {
			name={ p.Name } value={ p.Value }
		}
		{ withoutForm(p.Attrs)... }
	></button>
}

// withoutForm is attrs without its form attribute.
func withoutForm(attrs templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range attrs {
		if k != "form" {
			out[k] = v
		}
	}
	return out
}

// MoreActions lists the secondary actions under their heading.
templ MoreActions(items []MoreAction) {
	if len(items) > 0 {
		<section class="more-actions" aria-labelledby="more-actions-title">
			<h2 id="more-actions-title">{ moreActionsTitle }</h2>
			@MoreActionItems(items)
		</section>
	}
}

// MoreActionItems is the list alone, for a sheet that has its own heading; a
// POST action is a one-button form.
templ MoreActionItems(items []MoreAction) {
	<ul class="more-actions-items">
		for _, it := range items {
			<li>
				if it.Post {
					<form method="post" action={ templ.SafeURL(it.Href) }>
						<input type="hidden" name="csrf_token" value={ ui.ShellFrom(ctx).CSRF }/>
						for _, h := range it.Hidden {
							<input type="hidden" name={ h.Name } value={ h.Value }/>
						}
						@Button(ButtonProps{Label: it.Label, Busy: it.Label + "…", Variant: moreVariant(it.Danger)})
					</form>
				} else if it.NewTab {
					@Button(ButtonProps{Label: it.Label, AriaLabel: it.Label + " (opens in a new tab)", Href: it.Href, Variant: moreVariant(it.Danger), Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}})
				} else {
					@Button(ButtonProps{Label: it.Label, Href: it.Href, Variant: moreVariant(it.Danger)})
				}
			</li>
		}
	</ul>
}

// moreVariant is a More action's look: a dangerous one keeps its colour but
// is never filled, so it is never the loudest control on the page.
func moreVariant(danger bool) Variant {
	if danger {
		return DangerQuiet
	}
	return Ghost
}
