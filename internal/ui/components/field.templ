package components

import (
	"strings"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// FieldProps describes one form field. ID is the input's id (see FieldID);
// Error and Echo fill the message region, Error first. Required marks the
// label with an asterisk and the control with aria-required (CD-341 (2));
// Placeholder is an example value ("e.g. …"); Tip is longer help behind an
// info "i" beside the label (UI v2 §5.5). Clearable lets a chosen Picker be
// cleared (CD-217, CD-359 (1)); it marks nothing on the label.
type FieldProps struct {
	ID, Name, Label, Hint, Error, Value, Suffix, Echo string
	EchoNote                                          string // after the echo, also in /ui/validate's answer: "· the day the goods arrived" (UI v2 §5.7)
	EchoCheck                                         bool   // the echo has a check icon
	EchoMax                                           string // a date past this dd-mm-yyyy day echoes with no check, in /ui/validate's answer too
	Placeholder, Tip                                  string
	Required, Clearable                               bool
	Attrs                                             templ.Attributes

	labelFor string // the label's control, when it isn't ID (a chosen Picker)
}

// FieldID turns a field path into an element id: "lines[2].qty" becomes
// "f-lines-2-qty" and "supplier_id" becomes "f-supplier_id".
func FieldID(path string) string {
	var b strings.Builder
	b.WriteString("f-")
	dash := true
	for _, c := range path {
		if c == '_' || c == '-' || c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' {
			b.WriteRune(c)
			dash = false
		} else if !dash {
			b.WriteByte('-')
			dash = true
		}
	}
	return strings.TrimSuffix(b.String(), "-")
}

// describedBy names the hint, the tip and the message region, in that order.
func describedBy(p FieldProps) string {
	ids := ""
	if p.Hint != "" {
		ids += p.ID + "-hint "
	}
	if p.Tip != "" {
		ids += p.ID + "-tip "
	}
	return ids + p.ID + "-msg"
}

func labelTarget(p FieldProps) string {
	if p.labelFor != "" {
		return p.labelFor
	}
	return p.ID
}

// controlAttrs are the attributes every input, select and textarea shares.
func controlAttrs(p FieldProps, class string) templ.Attributes {
	a := templ.Attributes{
		"id":               p.ID,
		"name":             p.Name,
		"aria-describedby": describedBy(p),
		"class":            class,
	}
	if p.Error != "" {
		a["aria-invalid"] = "true"
		a["class"] = class + " field--error"
	}
	if p.Required {
		a["aria-required"] = "true"
	}
	if p.Placeholder != "" {
		a["placeholder"] = p.Placeholder
	}
	for k, v := range p.Attrs {
		a[k] = v
	}
	return a
}

// field is the label, hint and message region around a control.
templ field(p FieldProps) {
	<div class="fieldset field">
		if p.Tip != "" {
			<div class="field__top">
				@fieldLabel(p)
				@InfoTip(p.ID+"-tip", p.Label, p.Tip)
			</div>
		} else {
			@fieldLabel(p)
		}
		@fieldHint(p)
		{ children... }
		@fieldMsg(p.ID, p.Error, p.Echo, p.EchoCheck)
	</div>
}

// fieldLabel is the label; a required field's has the asterisk, a shape
// screen readers skip, and the words they read instead (§5.5 item 2).
templ fieldLabel(p FieldProps) {
	<label for={ labelTarget(p) } class="fieldset-legend field__label">
		{ p.Label }
		if p.Required {
			<span class="field__req" aria-hidden="true">*</span>
			<span class="visually-hidden">{ " (required)" }</span>
		}
	</label>
}

// choiceGroup is field for radios and checkboxes: a fieldset with a legend.
// A tip sits after the legend: a legend holds only its text.
templ choiceGroup(p FieldProps) {
	<fieldset class="fieldset field">
		<legend class="fieldset-legend field__label">
			{ p.Label }
			if p.Required {
				<span class="field__req" aria-hidden="true">*</span>
				<span class="visually-hidden">{ " (required)" }</span>
			}
		</legend>
		@choiceTip(p)
		@fieldHint(p)
		{ children... }
		@fieldMsg(p.ID, p.Error, p.Echo, p.EchoCheck)
	</fieldset>
}

templ choiceTip(p FieldProps) {
	if p.Tip != "" {
		@InfoTip(p.ID+"-tip", p.Label, p.Tip)
	}
}

templ fieldHint(p FieldProps) {
	if p.Hint != "" {
		<p id={ p.ID + "-hint" } class="label field__hint">{ p.Hint }</p>
	}
}

// fieldMsg is the message region: the error with its icon, else the echo, with
// a check icon when check. ValidateHandler renders the same element for htmx
// to swap.
templ fieldMsg(id, errText, echo string, check bool) {
	if errText != "" {
		<p id={ id + "-msg" } class="field__msg field__msg--error">
			@icons.Icon("circle-alert")
			<span>{ errText }</span>
		</p>
	} else if check && echo != "" {
		<p id={ id + "-msg" } class="field__msg field__msg--echo">
			@icons.Icon("check")
			<span>{ echo }</span>
		</p>
	} else {
		<p id={ id + "-msg" } class="field__msg">{ echo }</p>
	}
}
