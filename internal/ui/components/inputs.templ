package components

import (
	"encoding/json"
	"maps"
	"slices"
	"strconv"
	"unicode/utf16"

	"github.com/vardhan/internaltools/internal/types"
	"github.com/vardhan/internaltools/internal/ui/icons"
)

// NumberKind is a number field's kind; it names its /ui/validate endpoint.
type NumberKind string

// Number kinds (CD-48).
const (
	Money   NumberKind = "money"
	Qty     NumberKind = "qty"
	Rate    NumberKind = "rate"
	Percent NumberKind = "percent"
	Factor  NumberKind = "factor"
)

// CodeKind is a code field's kind; it names its /ui/validate endpoint.
type CodeKind string

// Code kinds; WP3 supplies their parsers.
const (
	GSTIN   CodeKind = "gstin"
	PAN     CodeKind = "pan"
	HSN     CodeKind = "hsn"
	Pincode CodeKind = "pincode"
	// GSTINState is GSTIN for a field that gives a state: its echo shows only
	// for a GSTIN that names one, so a quick sheet's State hides only then.
	GSTINState CodeKind = "gstin-state"
)

// DateProps describes a date field; Today, Yesterday and the optional
// bounds Min and Max are dd-mm-yyyy.
type DateProps struct {
	FieldProps
	Today, Yesterday string
	Min, Max         string
}

// pickerBounds are the calendar's min and max: the field's bounds as ISO
// dates, when it has them (CD-336 (1)).
func pickerBounds(p DateProps) templ.Attributes {
	a := templ.Attributes{}
	for k, v := range map[string]string{"min": p.Min, "max": p.Max} {
		if d, err := types.ParseDate(v); err == nil {
			a[k] = d.ISO()
		}
	}
	return a
}

// validateAttrs make a control check itself on change at /ui/validate/{kind};
// p.EchoNote goes along for the answer's echo.
func validateAttrs(p FieldProps, kind string) templ.Attributes {
	v := map[string]string{"_id": p.ID, "_name": p.Name}
	if p.EchoNote != "" {
		v["_note"] = p.EchoNote
	}
	if p.EchoMax != "" {
		v["_max"] = p.EchoMax
	}
	vals, _ := json.Marshal(v) //nolint:errchkjson // a string map always marshals
	return templ.Attributes{
		"hx-post":    "/ui/validate/" + kind,
		"hx-trigger": "change",
		"hx-target":  "#" + p.ID + "-msg",
		"hx-swap":    "outerHTML",
		"hx-vals":    string(vals),
	}
}

func counterText(n, maxLen int) string {
	return types.FormatCount(int64(n)) + " of " + types.FormatCount(int64(maxLen)) + " characters"
}

templ TextInput(p FieldProps) {
	@field(p) {
		<input type="text" value={ p.Value } { controlAttrs(p, "input field__input")... }/>
	}
}

templ EmailInput(p FieldProps, autocomplete string) {
	@field(p) {
		<input type="email" value={ p.Value } autocomplete={ autocomplete } spellcheck="false" { controlAttrs(p, "input field__input")... }/>
	}
}

// PasswordInput adds a "Show password" toggle handled by password.js, inside
// the box at its end (UI v2 §5.3). The button is named by its text, which
// password.js flips to "Hide password"; CSS hides that text and shows the eye
// glyph beside it, swapped while the password shows.
templ PasswordInput(p FieldProps, autocomplete string) {
	@field(p) {
		<div class="field__control password">
			<input type="password" value={ p.Value } autocomplete={ autocomplete } spellcheck="false" { controlAttrs(p, "input field__input")... }/>
			<button type="button" class="password__toggle" data-toggle-password aria-controls={ p.ID }>Show password</button>
			<span class="password__eye" aria-hidden="true">
				<span class="password__show">
					@icons.Icon("eye")
				</span>
				<span class="password__hide">
					@icons.Icon("eye-off")
				</span>
			</span>
		</div>
	}
}

// Textarea shows a live character count kept by counter.js. Like the
// browser's maxlength, it counts UTF-16 code units.
templ Textarea(p FieldProps, maxLen int) {
	@field(p) {
		<textarea maxlength={ strconv.Itoa(maxLen) } { controlAttrs(p, "textarea field__input")... }>{ p.Value }</textarea>
		<p class="field__count" data-counter={ p.ID }>{ counterText(len(utf16.Encode([]rune(p.Value))), maxLen) }</p>
	}
}

// scale is the decimals live grouping keeps for a field of kind k: NUM's
// scale, or 0 for a whole number (CD-336 (2)).
func scale(k NumberKind, whole bool) string {
	if whole {
		return "0"
	}
	return map[NumberKind]string{Money: "2", Qty: "3", Rate: "4", Percent: "3", Factor: "9"}[k]
}

// Signed is p for a number field that may be negative: live grouping keeps a
// typed minus only there (CD-336 (2)).
func Signed(p FieldProps) FieldProps {
	a := templ.Attributes{"data-signed": true}
	maps.Copy(a, p.Attrs)
	p.Attrs = a
	return p
}

// NumberInput is a text input checked by the server on change (CD-48) that
// groups its digits as typed (field.js, CD-336 (2)). Money and rate show "₹"
// inside the box at the start (left out in a narrow box, field.css); the
// suffix sits at its end.
templ NumberInput(p FieldProps, k NumberKind, whole bool) {
	@numberInput(p, k, whole, "join field__control")
}

// numberInput is NumberInput's body; control is the class of the box that
// holds the input, its prefix and its suffix.
templ numberInput(p FieldProps, k NumberKind, whole bool, control string) {
	@field(p) {
		<div class={ control }>
			<input
				type="text"
				if whole {
					inputmode="numeric"
				} else {
					inputmode="decimal"
				}
				autocomplete="off"
				value={ p.Value }
				data-scale={ scale(k, whole) }
				if k == Qty || k == Rate || k == Money {
					data-tap-select
				}
				{ validateAttrs(p, string(k))... }
				{ controlAttrs(p, "input join-item field__input num")... }
			/>
			if k == Money || k == Rate {
				<span class="field__pre" aria-hidden="true">₹</span>
			}
			if p.Suffix != "" {
				<span class="join-item field__suffix">{ p.Suffix }</span>
			} else if k == Percent {
				<span class="join-item field__suffix">%</span>
			}
		</div>
	}
}

templ MoneyInput(p FieldProps) {
	@NumberInput(p, Money, false)
}

// QtyInput shows the unit as the suffix; whole is for whole-number units.
templ QtyInput(p FieldProps, whole bool, uom string) {
	@NumberInput(withSuffix(p, uom), Qty, whole)
}

// LargeQtyInput is QtyInput at 56 px with 20 px figures, for a quantity
// typed with gloves under time pressure (CD-282 Q4, CD-286).
templ LargeQtyInput(p FieldProps, whole bool, uom string) {
	@numberInput(withSuffix(p, uom), Qty, whole, "join field__control field__control--lg")
}

templ RateInput(p FieldProps) {
	@NumberInput(p, Rate, false)
}

templ PercentInput(p FieldProps) {
	@NumberInput(p, Percent, false)
}

func withSuffix(p FieldProps, s string) FieldProps {
	p.Suffix = s
	return p
}

// dateField is p's field with the date hint when it has none, the weekday of
// its value as the echo when it has none (CD-326 (5)), EchoNote after it, and
// the echo's check icon (UI v2 §5.7) unless the value is past Max.
func dateField(d DateProps) FieldProps {
	p := d.FieldProps
	if p.Hint == "" {
		p.Hint = "For example, 27-03-2026"
	}
	if p.Echo == "" {
		p.Echo = weekday(p.Value)
	}
	p.Echo, p.EchoCheck, p.EchoMax = noted(p.Echo, p.EchoNote), !pastMax(p.Value, d.Max), d.Max
	return p
}

// dateChip is a date button under the box: its label and dd-mm-yyyy day.
type dateChip struct{ Label, Day string }

// dateChips are p's Today and Yesterday, leaving out one with no day: its tap
// would blank the field.
func dateChips(p DateProps) []dateChip {
	return slices.DeleteFunc([]dateChip{{"Today", p.Today}, {"Yesterday", p.Yesterday}}, func(c dateChip) bool { return c.Day == "" })
}

// chipPressed is a chip's aria-pressed: whether value is its day, in any form
// the server reads (UI v2 §5.7). date.js keeps it as the box changes.
func chipPressed(value, day string) string {
	d, err := types.ParseDate(value)
	return strconv.FormatBool(err == nil && types.FormatDate(d) == day)
}

// DateInput is a dd-mm-yyyy text input that takes its dashes as digits are
// typed, with a "Choose date" button that opens the platform picker through a
// hidden date input, "Today" and "Yesterday" chips (date.js, CD-336 (1),
// CD-387 (9)) and the weekday echo in the message region, rendered here on
// every draw and by /ui/validate/date on change.
templ DateInput(p DateProps) {
	@field(dateField(p)) {
		<div class="field__date">
			<input
				type="text"
				inputmode="numeric"
				autocomplete="off"
				placeholder="dd-mm-yyyy"
				value={ p.Value }
				data-date
				data-tap-select
				{ validateAttrs(dateField(p), "date")... }
				{ controlAttrs(dateField(p), "input field__input")... }
			/>
			<button type="button" class="field__cal" data-date-pick aria-controls={ p.ID } aria-label="Choose date">
				@icons.Icon("calendar")
			</button>
			<input type="date" class="field__picker" data-date-picker={ p.ID } tabindex="-1" aria-hidden="true" { pickerBounds(p)... }/>
		</div>
		if chips := dateChips(p); len(chips) > 0 {
			<div class="field__actions">
				for _, c := range chips {
					<button type="button" class="btn btn-outline tap field__chip" data-set-date={ c.Day } aria-controls={ p.ID } aria-pressed={ chipPressed(p.Value, c.Day) }>{ c.Label }</button>
				}
			</div>
		}
	}
}

// CodeInput is a GSTIN, PAN, HSN or pincode field checked on change.
templ CodeInput(p FieldProps, k CodeKind) {
	@field(p) {
		<input
			type="text"
			if k == GSTIN || k == GSTINState || k == PAN {
				autocapitalize="characters"
			} else {
				inputmode="numeric"
			}
			spellcheck="false"
			autocomplete="off"
			value={ p.Value }
			{ validateAttrs(p, string(k))... }
			{ controlAttrs(p, "input field__input code")... }
		/>
	}
}
