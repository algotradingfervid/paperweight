package wizard

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/icons"
)

// Stepper is the progress indicator (UI v2 §5.6, A-13): numbered dots joined
// by lines. Done steps show a check and are links ("Completed: " for screen
// readers), the current step's label is the h2#step-title, visited steps
// after it are numbered links and steps beyond Furthest are text. "Step n of
// N" is only read out, through the heading's aria-describedby (#step-count).
// The heading takes focus unless errors or a conflict are shown.
templ Stepper(m Model) {
	<nav class="stepper" aria-label={ m.Title + " steps" }>
		<ol class="stepper__list">
			for i, s := range m.Steps {
				if i < m.Current {
					<li class="stepper__step is-done">
						<a class="stepper__item" href={ templ.SafeURL(m.StepURL(i)) }>
							<span class="stepper__dot" aria-hidden="true">
								@icons.Icon("check-heavy")
							</span>
							<span class="stepper__label"><span class="visually-hidden">Completed: </span>{ s.Label }</span>
						</a>
					</li>
				} else if i == m.Current {
					<li class="stepper__step is-current" aria-current="step">
						<span class="stepper__item">
							@stepDot()
							if len(m.Errors) == 0 && m.Conflict == "" && m.Danger == "" {
								<h2 class="stepper__label" id="step-title" tabindex="-1" aria-describedby="step-count" autofocus>{ s.Label }</h2>
							} else {
								<h2 class="stepper__label" id="step-title" tabindex="-1" aria-describedby="step-count">{ s.Label }</h2>
							}
						</span>
					</li>
				} else if i <= m.Furthest {
					<li class="stepper__step is-visited">
						<a class="stepper__item" href={ templ.SafeURL(m.StepURL(i)) }>
							@stepDot()
							<span class="stepper__label">{ s.Label }</span>
						</a>
					</li>
				} else {
					<li class="stepper__step">
						<span class="stepper__item">
							@stepDot()
							<span class="stepper__label">{ s.Label }</span>
						</span>
					</li>
				}
			}
		</ol>
		<p class="stepper__count visually-hidden" id="step-count">Step { strconv.Itoa(m.Current+1) } of { strconv.Itoa(len(m.Steps)) }</p>
	</nav>
}

// stepDot is a step's numbered dot; the number comes from a CSS counter, so
// each step's text is its label alone.
templ stepDot() {
	<span class="stepper__dot" aria-hidden="true"></span>
}
