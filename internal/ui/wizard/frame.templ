package wizard

import (
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"

	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/icons"
)

// Bar is the step's action bar: the primary label (default "Save and
// continue", or "Continue" in a master wizard, UI v2 §5.6), whether "Back" shows, and NoPrimary for a step with no
// primary (a check page the user may not submit). EnterPrimary starts the
// step form with components.EnterSubmit of the primary, for a body with
// submit buttons of its own, so Enter still presses the primary (CD-286 R4).
// Summary is the footer's row above the buttons (the Items total, A-22).
type Bar struct {
	Primary      string
	Back         bool
	NoPrimary    bool
	PrimaryNav   string           // the primary's nav value; "" keeps the default
	BackLink     *components.Link // a Back link in place of the Back button
	EnterPrimary bool
	Summary      templ.Component
}

// formID is the step form's id; when m.After follows the form, the bar's
// buttons sit after it and post it through their form attribute.
const formID = "wizard-form"

// disabledElt disables, while the step form's request runs, every submit
// in it and every bar button posting it. htmx resolves plain selectors to
// all matches ("find" only to the first).
const disabledElt = "#" + formID + " button[type=submit], button[form=" + formID + "]"

func (b Bar) primary(m Model) string {
	switch {
	case b.Primary != "":
		return b.Primary
	case m.Mode == Master:
		return "Continue"
	}
	return "Save and continue"
}

func (b Bar) props(m Model) components.ActionBarProps {
	p := components.ActionBarProps{
		// The check step has nothing to save, and its form posts the
		// submit, so it has no "Save and finish later".
		FinishLater: m.Mode == Document && !m.Last(),
		Summary:     b.Summary,
	}
	if m.After != nil {
		p.Form = formID
	}
	if !b.NoPrimary {
		p.Primary = &components.ButtonProps{Label: b.primary(m), Variant: components.Primary}
		if b.PrimaryNav != "" {
			p.Primary.Name, p.Primary.Value = "nav", b.PrimaryNav
		}
	}
	switch {
	case b.Back && b.BackLink != nil:
		p.Secondary = &components.ButtonProps{Label: b.BackLink.Label, Href: b.BackLink.Href, Variant: components.Secondary}
	case b.Back:
		p.Secondary = &components.ButtonProps{Label: "Back", Icon: "chevron-left", Name: "nav", Value: "back", Variant: components.Secondary, Attrs: noWrite(m.Mode != Document)}
	}
	return p
}

// noWrite marks a master wizard's form or button for app.js when on: its
// request writes only the session, so a lost answer saved nothing and Try again
// is safe. The last step's primary creates the record, so there only Back is
// marked (CD-387 (5)).
func noWrite(on bool) templ.Attributes {
	if !on {
		return nil
	}
	return templ.Attributes{"data-no-write": true}
}

// reloadLabel is the record the conflict banner's Reload names: the document
// being edited (UI v2 §5.14, A-29), and only that one. A new document has no
// label yet, and a master wizard's DocLabel names a kind of record.
func reloadLabel(m Model) string {
	if m.Mode != Document {
		return ""
	}
	return m.DocLabel
}

func titleLine(m Model) string {
	if m.DocLabel == "" {
		return m.Title
	}
	return m.Title + " · " + m.DocLabel
}

// heading is the wizard head's h1 (UI v2 §5.6): a document's label once it
// is saved, "New purchase order" before; a master wizard's title line.
func heading(m Model) string {
	switch {
	case m.Mode != Document:
		return titleLine(m)
	case m.DocLabel != "":
		return m.DocLabel
	}
	return "New " + sentenceCase(m.Title)
}

// metaLine is the wizard head's meta line: the title in sentence case
// ("Purchase Order" → "Purchase order").
func metaLine(title string) string {
	s := sentenceCase(title)
	r, n := utf8.DecodeRuneInString(s)
	return string(unicode.ToUpper(r)) + s[n:]
}

// sentenceCase lowers each word's first letter ("Purchase Order" →
// "purchase order"), leaving words with more capitals ("GST") as they are.
func sentenceCase(s string) string {
	words := strings.Fields(s)
	for i, w := range words {
		r, n := utf8.DecodeRuneInString(w)
		if strings.ToLower(w[n:]) == w[n:] {
			words[i] = string(unicode.ToLower(r)) + w[n:]
		}
	}
	return strings.Join(words, " ")
}

// Frame is one wizard step, swapped whole as #wizard: the wizard head (head),
// with the page's h1, the stepper with the step heading (h2#step-title), the step's
// intro, conflict banner, error summary, warnings, the step
// form around children and the action bar, or, with m.After, the form,
// m.After and then the bar posting the form from outside; then m.Below. In Document mode the
// form holds the page's one #doc-version (CD-95). Focus goes to the heading unless errors or a
// conflict are shown; on a conflict without errors the banner's wrapper
// takes focus.
templ Frame(m Model, bar Bar) {
	<div id="wizard">
		@head(m)
		@Stepper(m)
		if in := m.Steps[m.Current].Intro; in != "" {
			<p class="step-intro">{ in }</p>
		}
		if m.Conflict != "" && len(m.Errors) == 0 {
			<div id="wizard-conflict" tabindex="-1" autofocus>
				@conflictBanner(m)
			</div>
		} else if m.Conflict != "" {
			@conflictBanner(m)
		}
		if m.Danger != "" && len(m.Errors) == 0 {
			<div id="wizard-danger" tabindex="-1" autofocus>
				@dangerBanner(m)
			</div>
		} else if m.Danger != "" {
			@dangerBanner(m)
		}
		@components.ErrorSummary(m.Errors)
		@components.Warnings(m.Warnings)
		@components.Warnings(m.Stored)
		@components.Form(components.FormProps{ID: formID, Action: m.formAction(), HX: true, Target: m.formTarget(), DisabledElt: disabledElt, Attrs: formAttrs(m)}) {
			if p := bar.props(m).Primary; bar.EnterPrimary && p != nil {
				@components.EnterSubmit(*p)
				{ children... }
			} else {
				{ children... }
			}
			if m.Mode == Document {
				@DocVersion(m.Version, false)
			}
			if m.ReturnTo != "" {
				<input type="hidden" name="return" value={ m.ReturnTo }/>
			}
			if m.After == nil {
				@components.ActionBar(bar.props(m))
			}
		}
		if m.After != nil {
			@m.After
			@components.ActionBar(bar.props(m))
		}
		if m.Below != nil {
			@m.Below
		}
	</div>
}

// DocVersion is the document's one version input, #doc-version (CD-95);
// oob renders it as an out-of-band swap for a line-grid row save.
templ DocVersion(version int, oob bool) {
	if oob {
		<input type="hidden" id="doc-version" name="version" value={ strconv.Itoa(version) } hx-swap-oob="true"/>
	} else {
		<input type="hidden" id="doc-version" name="version" value={ strconv.Itoa(version) }/>
	}
}

// formAttrs are the step form's attributes: noWrite's, and data-unsaved with
// m.Unsaved, so app.js counts the form as changed and the × asks (CD-387
// (4)).
func formAttrs(m Model) templ.Attributes {
	a := noWrite(m.Mode != Document && !m.Last())
	if m.Unsaved {
		if a == nil {
			a = templ.Attributes{}
		}
		a["data-unsaved"] = true
	}
	return a
}

// leaveID is the "Leave without saving?" dialog's id.
const leaveID = "leave-wizard"

// leaveText is the leave dialog's text: a Held wizard keeps the other steps,
// until Start over where it is offered; a saved document keeps every step
// saved before; a new document and any other master wizard have nothing
// saved yet (UI v2 §5.6).
func leaveText(m Model) string {
	switch {
	case m.Held && m.StartOver:
		return "What you typed on this step is lost. Start over clears the rest."
	case m.Held:
		return "What you typed on this step is lost."
	case m.Mode == Document && m.DocLabel != "":
		return "What you changed on this step is lost. The draft keeps what was saved before."
	}
	return "What you typed in this wizard is lost."
}

// head is the wizard head (UI v2 §5.6): the close ×, when m.Close is set,
// then a document's kind as the meta line above the h1, and, in Document
// mode, the save cue. On phones in focus mode it is the sticky top bar.
// The × goes to Close in one press; app.js opens "Leave without saving?"
// first only when the step form has unsaved changes (data-if-dirty, CD-387
// (4)). Without JavaScript it goes straight to Close.
templ head(m Model) {
	<div class="wizard-head">
		if m.Close != "" {
			<a class="btn btn-ghost btn-square wizard-close" href={ templ.SafeURL(m.Close) } aria-label="Close" aria-haspopup="dialog" data-open-dialog={ leaveID } data-if-dirty={ formID }>
				@icons.Icon("x")
			</a>
		}
		<div class="wizard-head__text">
			if m.Mode == Document {
				<p class="wizard-head__meta">{ metaLine(m.Title) }</p>
			}
			<h1 class="wizard-title">{ heading(m) }</h1>
		</div>
		if m.Mode == Document {
			@saveCue(m.DocLabel == "")
		}
		if m.Close != "" {
			@components.Dialog(leaveID, "Leave without saving?") {
				<p>{ leaveText(m) }</p>
				<div class="cluster">
					@components.Button(components.ButtonProps{Label: "Keep editing", Type: "button", Attrs: templ.Attributes{"data-close-dialog": true}})
					@components.Button(components.ButtonProps{Label: "Leave", Href: m.Close, Variant: components.Danger})
				</div>
			}
		}
	</div>
}

// LineHead is the wizard head of a page under a wizard step, such as a line
// page (UI v2 §5.6, CD-387 (6)): the 44 px ‹ back to that step, the
// document's kind as the meta line, and the page's one h1. On phones in focus
// mode it is the sticky top bar, as the step's head is. The ‹ is a plain
// link: the page's form saves nothing until its own button.
templ LineHead(back components.Link, kind, title string) {
	<div class="wizard-head">
		<a class="btn btn-ghost btn-square wizard-close" href={ templ.SafeURL(back.Href) } aria-label={ "Back to " + back.Label }>
			@icons.Icon("chevron-left")
		</a>
		<div class="wizard-head__text">
			<p class="wizard-head__meta">{ metaLine(kind) }</p>
			<h1 class="wizard-title" id="page-title" tabindex="-1">{ title }</h1>
		</div>
	</div>
}

// SavedAtID is the save cue's live region, which app.js fills from a step
// save's HX-Trigger saved (Respond).
const SavedAtID = "saved-at"

// saveCue is the save cue: "Not saved yet" on a new document, "Saving…"
// while the step form's request runs (its bar buttons are disabled; CSS),
// and the "Saved {HH:MM}" app.js writes into #saved-at after a save.
// hx-preserve keeps the cue, and what app.js wrote, across step swaps.
templ saveCue(isNew bool) {
	<p class="save-cue" id="save-cue" hx-preserve="true">
		if isNew {
			<span class="save-cue__new">
				@icons.Icon("circle-dashed")
				Not saved yet
			</span>
		}
		<span class="save-cue__saving">
			@icons.Icon("refresh-cw")
			Saving…
		</span>
		<span class="save-cue__saved">
			@icons.Icon("cloud-check")
			<span id={ SavedAtID } aria-live="polite"></span>
		</span>
	</p>
}

templ dangerBanner(m Model) {
	@components.Banner(components.BannerProps{Kind: components.Danger, Message: m.Danger})
}

templ conflictBanner(m Model) {
	@components.ConflictBanner(m.Conflict, reloadLabel(m), m.ReloadURL)
}
