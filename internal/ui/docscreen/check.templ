package docscreen

import (
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/wizard"
)

// checkBody is the check page after the step form: the approval preview
// and the module's notes and warnings, one summary card per step, the
// Attachments card, the module's cards (CD-263 G2), the total in figures
// and words, the module's totals apart from them (CD-275, CD-326 (4)), and
// More actions (design-system §8.3).
templ checkBody(cv checkView) {
	if cv.AmendedFrom != "" {
		<p>
			@components.Button(components.ButtonProps{Label: "Amended from " + cv.AmendedFrom, Href: cv.AmendedURL, Variant: components.Ghost})
		</p>
	}
	if cv.Preview != "" {
		@components.Banner(components.BannerProps{Kind: components.Info, Message: cv.Preview})
	}
	for _, n := range cv.Extra.Notes {
		@components.Banner(components.BannerProps{Kind: components.Info, Message: n})
	}
	@components.Warnings(cv.Extra.Warnings)
	for _, s := range cv.Sections {
		@wizard.CheckSection(s.Title, s.Status, s.ChangeURL) {
			if len(s.Problems) > 0 {
				<ul>
					for _, p := range s.Problems {
						<li>{ p }</li>
					}
				</ul>
			}
			if s.Lines != nil {
				@components.LineList(*s.Lines)
			} else if len(s.Pairs) > 0 {
				@components.SummaryList(s.Pairs)
			} else if len(s.Problems) == 0 {
				<p>Nothing needed here</p>
			}
		}
	}
	if cv.Attach != nil {
		@attachCard(*cv.Attach)
	}
	for _, c := range cv.Extra.Cards {
		@c
	}
	if len(cv.Extra.Totals) > 0 {
		<div class="stack">
			@grandTotal(cv)
			@components.SummaryList(cv.Extra.Totals)
		</div>
	} else {
		@grandTotal(cv)
	}
	@components.MoreActions(cv.More)
}

// grandTotal is the total in figures and words; the module's totals follow
// it with a gap (CD-326 (4)).
templ grandTotal(cv checkView) {
	if cv.GrandTotal != "" {
		<div>
			<p class="num text-2xl font-semibold">{ cv.GrandTotal }</p>
			if cv.Words != "" {
				@components.AmountInWords(cv.Words)
			}
		</div>
	}
}
