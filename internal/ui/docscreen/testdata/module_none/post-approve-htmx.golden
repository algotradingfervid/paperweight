<title>Draft 42 · </title><main id="main" class="app-main"><div class="stack content"><a class="back-link" href="/doc/docscreentest.Sample"><svg class="icon" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg> Sample Orders</a> <div class="success-block" role="status" tabindex="-1" autofocus><section class="card card-border"><div class="card-body"><div class="success-block__head"><span class="success-block__tick" aria-hidden="true"><svg class="icon" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg></span><div class="success-block__words"><h2 class="success-block__title">Approved</h2><p class="success-block__text">SO/26-27/00001 has been numbered.</p></div></div><div class="success-block__links"><a href="/approvals" class="btn tap btn-outline btn--secondary"><span>Next request</span></a><a href="/doc/docscreentest.Sample/new" class="btn tap btn-outline btn--secondary"><span>New sample order</span></a></div></div></section></div><div class="doc-layout"><div class="doc-main"><section class="card card-border"><div class="card-body"><div class="doc-head"><div class="doc-head__top"><h1 id="page-title" tabindex="-1">Draft 42</h1><span class="badge badge--approved"><svg class="icon" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg> Approved</span></div><div><p class="doc-head__amount num">₹94,164.00</p><p class="in-words">Rupees Ninety Four Thousand One Hundred Sixty Four Only</p></div><