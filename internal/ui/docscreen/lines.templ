package docscreen

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
	"github.com/vardhan/internaltools/internal/ui/wizard"
)

// itemsPart is the items step after the step form: #grid-alerts for a
// refused grid save, the line cards and grid, and the computed totals.
templ itemsPart(iv itemsView) {
	<div id="grid-alerts"></div>
	@components.LineList(iv.List)
	@docTotals(iv.Totals, false)
}

// docTotals are the computed header fields; a grid save swaps them out of
// band (CD-95).
templ docTotals(pairs []components.Pair, oob bool) {
	<div
		id="doc-totals"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(pairs) > 0 {
			@components.SummaryList(pairs)
		}
	</div>
}

// gridItem is a grid row's item cell: the chosen master's summary, its error
// and its hidden value (CD-139); the item is changed on the line page. The
// div is the one grid cell the summary and the error share.
templ gridItem(id, label, shown, name, value, errText string) {
	<div>
		<p><span class="visually-hidden">{ label + ": " }</span>{ shown }</p>
		@components.LineGridError(id, errText)
	</div>
	<input type="hidden" name={ name } value={ value }/>
}

// gridResponse is a grid row save's answer: the row for its
// hx-target="this" swap, then out-of-band updates.
templ gridResponse(g gridView) {
	@components.LineGridRowForm(g.Row)
	if g.Rows != nil {
		@wizard.DocVersion(g.Version, true)
		@components.LineGridVersions(g.Rows, strconv.Itoa(g.Version))
		@docTotals(g.Totals, true)
	}
	if g.Alert != "" || len(g.Warnings) > 0 {
		<div id="grid-alerts" hx-swap-oob="true">
			if g.Alert != "" {
				@components.Banner(components.BannerProps{Kind: components.Danger, Message: g.Alert, Link: &components.Link{Label: "Reload", Href: g.ReloadURL}})
			}
			@components.Warnings(g.Warnings)
		</div>
	}
}

templ linePageFull(lp linePageView) {
	@layout.Page(linePageOpts(lp)) {
		@linePageBody(lp)
	}
}

templ linePageMain(lp linePageView) {
	@layout.Main(linePageOpts(lp)) {
		@linePageBody(lp)
	}
}

templ linePageBanners(lp linePageView) {
	if lp.Danger != "" {
		@components.Banner(components.BannerProps{Kind: components.Danger, Message: lp.Danger})
	}
	@components.ErrorSummary(lp.Errors)
}

// linePageBody is the line form ("Save line") or the remove question.
templ linePageBody(lp linePageView) {
	if lp.Question != "" {
		<p>{ lp.Question }</p>
	}
	@components.Form(components.FormProps{Action: lp.Action}) {
		<input type="hidden" name="version" value={ strconv.Itoa(lp.Version) }/>
		for _, c := range lp.Inputs {
			@c
		}
		@components.Button(lp.Button)
	}
}
