package docscreen

import (
	"slices"
	"strconv"

	"github.com/vardhan/internaltools/internal/kernel/doctype"
	"github.com/vardhan/internaltools/internal/ui/components"
	"github.com/vardhan/internaltools/internal/ui/layout"
)

templ docPage(pv pageView) {
	@layout.Page(docOpts(pv)) {
		@docBody(pv)
	}
}

templ docMain(pv pageView) {
	@layout.Main(docOpts(pv)) {
		@docBody(pv)
	}
}

// docBanners sit above the h1: a rejected document's reason first, then a
// refused action's message, then an action's success and, after an approve,
// the "Next request" link straight under it, and the module's notice last
// (CD-263 G3). After a Submit the success is the success block (A-25).
templ docBanners(pv pageView) {
	if pv.V.Info.State == doctype.StateRejected && pv.V.Origin.StateReason != "" {
		@components.Banner(components.BannerProps{Kind: components.Danger, Message: pv.V.Origin.StateReason})
	}
	if pv.Danger != "" {
		@alertFocus("doc-alert", len(pv.Errors) == 0) {
			if pv.Reload != nil {
				@components.ConflictBanner(pv.Danger, pv.Reload.Label, pv.Reload.Href)
			} else {
				@components.Banner(components.BannerProps{Kind: components.Danger, Message: pv.Danger})
			}
		}
	}
	@components.ErrorSummary(pv.Errors)
	if pv.Block {
		@components.SuccessBlock(components.SuccessProps{Message: pv.Success, Links: pv.Follow})
	} else if pv.Success != "" {
		@components.Banner(components.BannerProps{Kind: components.Success, Message: pv.Success})
	}
	if pv.Next != "" {
		// A space keeps the banner's text and the link's apart in the page text.
		{ " " }
		<p><a href={ templ.SafeURL(pv.Next) }>Next request</a></p>
	}
	if pv.Extra.Notice != nil {
		@components.Banner(*pv.Extra.Notice)
	}
}

// alertFocus is a refusal's banner, holding focus as the wizard's does unless
// the error summary holds it (focus false).
templ alertFocus(id string, focus bool) {
	if focus {
		<div id={ id } tabindex="-1" autofocus>
			{ children... }
		</div>
	} else {
		{ children... }
	}
}

// docBody follows the phone order of design-system §8.4, with the header
// card first (UI v2 §5.13); from 80rem the Actions card, the attachments and
// approval history sit in a side panel, the card moved to the top
// (doc-actions). On phones the actions come last, as the bottom bar, in
// tree order too. Every value is read-only.
templ docBody(pv pageView) {
	<div class="doc-layout">
		<div class="doc-main">
			@components.DocHeader(components.DocHeaderProps{
				Title: pv.V.Info.Display, State: pv.V.Info.State, StateLabel: pv.DT.StateLabels[pv.V.Info.State],
				Amount: pv.V.GrandTotal, InWords: pv.V.InWords, Facts: pv.Facts, Steps: pv.Steps,
			})
			if pv.Party != "" {
				<p>{ pv.Party }</p>
			}
			if s := waitingLine(pv); s != "" {
				<p>{ s }</p>
			}
			if pv.V.Origin.AmendedFrom != "" {
				<p>
					@components.Button(components.ButtonProps{Label: "Amended from " + pv.V.Origin.AmendedFrom, Href: docURL(pv.DT.Name, pv.V.Origin.AmendedFromID), Variant: components.Ghost})
				</p>
			}
			@components.Warnings(slices.Concat(pv.V.Warnings, pv.Extra.Warnings))
			@components.Card("Details", nil) {
				@components.SummaryList(slices.Concat(pv.V.Header, pv.Extra.Pairs))
			}
			if len(pv.V.Lines) > 0 {
				@components.Card("Lines", nil) {
					@components.LineList(*pv.Lines)
				}
			}
			for _, c := range pv.Extra.Cards {
				@c
			}
			if len(pv.V.History) > 0 {
				<div class="doc-audit">
					@components.Disclosure("History", false) {
						@History(pv.V.History)
					}
				</div>
			}
		</div>
		<div class="doc-side">
			if pv.Attach != nil {
				@attachCard(*pv.Attach)
			} else if !pv.DT.Attachable && pv.Extra.Files != nil {
				if len(pv.Extra.Files.Items) > 0 {
					@components.Card(pv.Extra.Files.Title, nil) {
						@components.Attachments(pv.Extra.Files.Items)
					}
				}
			} else if !pv.DT.Attachable && len(pv.V.Attachments) > 0 {
				@components.Card("Attachments", nil) {
					@components.Attachments(pv.V.Attachments)
				}
			}
			if len(pv.V.Approval.History) > 0 {
				@components.Disclosure("Approval history", false) {
					@History(pv.V.Approval.History)
				}
			}
			if hasActions(pv) {
				<div class="doc-actions">
					@components.Card("Actions", nil) {
						@components.MoreActions(pv.More)
						@components.ActionBar(pv.Bar)
					}
				</div>
			}
		</div>
	</div>
}

// docBar is the hidden forms the Actions card's buttons post through (each
// with the page's version, CD-94).
templ docBar(pv pageView) {
	for _, f := range pv.Forms {
		@components.Form(components.FormProps{ID: f.ID, Action: f.Action, HX: true}) {
			<input type="hidden" name="version" value={ strconv.Itoa(f.Version) }/>
		}
	}
}

// hasActions reports whether the page has an action or the bar's note to show.
func hasActions(pv pageView) bool {
	return pv.Bar != (components.ActionBarProps{}) || len(pv.More) > 0
}
