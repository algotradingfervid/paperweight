package views

import (
	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
	"github.com/vardhan/internaltools/internal/ui/components"
	uilayout "github.com/vardhan/internaltools/internal/ui/layout"
)

func (Default) Login(p authweb.LoginPage) templ.Component {
	return login(p)
}

// login is the sign-in form. The email is never re-filled after a failed
// attempt, so a wrong password and an unknown email answer alike (AUTH-004).
templ login(p authweb.LoginPage) {
	@page(uilayout.PageOpts{Title: "Sign in", Bare: true, Width: uilayout.Form}, p.CSRF, p.Error, components.FieldID("email"), p.Warnings) {
		@components.Form(components.FormProps{Action: "/signin", CSRF: p.CSRF}) {
			if p.Next != "" {
				@components.Hidden("next", p.Next)
			}
			<div class="stack">
				@components.EmailInput(components.FieldProps{ID: components.FieldID("email"), Name: "email", Label: "Email", Attrs: required}, "username")
				@components.PasswordInput(components.FieldProps{ID: components.FieldID("password"), Name: "password", Label: "Password", Attrs: required}, "current-password")
				@components.Button(components.ButtonProps{Label: "Sign in", Busy: "Signing in…", Variant: components.Primary})
			</div>
		}
	}
}
