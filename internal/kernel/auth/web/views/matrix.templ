package views

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/vardhan/internaltools/internal/kernel/auth"
	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
)

func (Default) Matrix(p authweb.MatrixPage) templ.Component {
	return matrix(p)
}

// capitalise upper-cases the first letter: "read" → "Read", "all" → "All".
func capitalise(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// matrix is one DocType's rights page.
templ matrix(p authweb.MatrixPage) {
	@layout("Rights on "+p.Label, p.CSRF, "", nil) {
		@matrixBody(p)
	}
}

// matrixBody is one form per role: each right is None or one of the
// DocType's scope options (Team only where it has an employee field, CD-11).
templ matrixBody(p authweb.MatrixPage) {
	<section>
		<h2>{ p.Label }</h2>
		for _, row := range p.Roles {
			if row.Role.IsAdmin {
				<p>{ row.Role.Name }: every right that applies. { auth.ErrAdminRoleFixed.Msg }</p>
			} else {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/roles/%d/rights/%s", row.Role.ID, p.DocType)) }>
					<input type="hidden" name="csrf_token" value={ p.CSRF }/>
					<input type="hidden" name="version" value={ strconv.FormatInt(row.Role.Version, 10) }/>
					<fieldset>
						<legend>{ row.Role.Name }</legend>
						for _, rt := range p.Rights {
							<label>
								{ capitalise(string(rt)) }
								<select name={ string(rt) }>
									<option value="" selected?={ row.Rights[rt] == "" }>None</option>
									for _, sc := range p.Scopes {
										<option value={ string(sc) } selected?={ row.Rights[rt] == sc }>{ capitalise(string(sc)) }</option>
									}
								</select>
							</label>
						}
						<button type="submit">Save</button>
					</fieldset>
				</form>
			}
		}
		<form method="post" action={ templ.SafeURL("/rights/" + p.DocType + "/reset") }>
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<button type="submit">Reset to defaults</button>
		</form>
	</section>
}
