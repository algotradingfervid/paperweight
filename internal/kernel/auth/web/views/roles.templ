package views

import (
	"fmt"
	"strconv"

	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
)

func (Default) Roles(p authweb.RolesPage) templ.Component {
	return roles(p)
}

// usersText is "1 user" or "n users".
func usersText(n int) string {
	if n == 1 {
		return "1 user"
	}
	return fmt.Sprintf("%d users", n)
}

// roles lists the roles with their rename and delete forms, then the rights
// matrix of every DocType.
templ roles(p authweb.RolesPage) {
	@layout("Roles", p.CSRF, "", p.Warnings) {
		<form method="post" action="/roles">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label>
				Name
				<input type="text" name="name" required/>
			</label>
			<button type="submit">Add role</button>
		</form>
		<ul>
			for _, r := range p.Roles {
				<li>
					{ r.Name } ({ usersText(r.Users) })
					if !r.IsAdmin {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/roles/%d/rename", r.ID)) }>
							<input type="hidden" name="csrf_token" value={ p.CSRF }/>
							<input type="hidden" name="version" value={ strconv.FormatInt(r.Version, 10) }/>
							<input type="text" name="name" value={ r.Name } required/>
							<button type="submit">Rename</button>
						</form>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/roles/%d/delete", r.ID)) }>
							<input type="hidden" name="csrf_token" value={ p.CSRF }/>
							<input type="hidden" name="version" value={ strconv.FormatInt(r.Version, 10) }/>
							<button type="submit">Delete</button>
						</form>
					}
				</li>
			}
		</ul>
		for _, m := range p.Matrices {
			@matrixBody(m)
		}
	}
}
