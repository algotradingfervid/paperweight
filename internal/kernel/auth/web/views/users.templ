package views

import (
	"fmt"

	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
)

func (Default) Users(p authweb.UsersPage) templ.Component {
	return users(p)
}

templ users(p authweb.UsersPage) {
	@layout("Users", p.CSRF, p.Error, p.Warnings) {
		<ul>
			for _, u := range p.Users {
				<li><a href={ templ.SafeURL(fmt.Sprintf("/users/%d", u.ID)) }>{ u.Name }</a> { u.Email }</li>
			}
		</ul>
	}
}
