package views

import (
	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
	"github.com/vardhan/internaltools/internal/ui/components"
	uilayout "github.com/vardhan/internaltools/internal/ui/layout"
)

func (Default) Password(p authweb.PasswordPage) templ.Component {
	return password(p)
}

// required marks a field the form cannot be sent without.
var required = templ.Attributes{"required": true}

// passwordRules lists the password policy (auth.CheckPolicy) before the
// fields (design-system §8.7); change says the new one must differ from the
// current one.
templ passwordRules(change bool) {
	<div id="password-rules">
		<p>Your password must:</p>
		<ul class="list-disc ps-6">
			<li>be at least 10 characters and at most 256</li>
			<li>not be a common password</li>
			<li>not contain your name or email</li>
			if change {
				<li>be different from your current password</li>
			}
		</ul>
	</div>
}

// password is the change-password form; the password rules come before the
// fields.
templ password(p authweb.PasswordPage) {
	@page(uilayout.PageOpts{Title: "Change password", Width: uilayout.Form}, p.CSRF, p.Error, components.FieldID("current"), p.Warnings) {
		if p.Forced {
			@components.Banner(components.BannerProps{Kind: components.Info, Message: "Choose a new password to continue."})
		}
		<form method="post" action="/account/password" class="stack">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			@passwordRules(true)
			@components.PasswordInput(components.FieldProps{ID: components.FieldID("current"), Name: "current", Label: "Current password", Attrs: required}, "current-password")
			@components.PasswordInput(components.FieldProps{ID: components.FieldID("next"), Name: "next", Label: "New password", Attrs: required}, "new-password")
			@components.PasswordInput(components.FieldProps{ID: components.FieldID("confirm"), Name: "confirm", Label: "Confirm new password", Attrs: required}, "new-password")
			@components.Button(components.ButtonProps{Label: "Change password", Variant: components.Primary})
		</form>
	}
}
