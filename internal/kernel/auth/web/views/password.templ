package views

import authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"

func (Default) Password(p authweb.PasswordPage) templ.Component {
	return password(p)
}

// password is the change-password form.
templ password(p authweb.PasswordPage) {
	@layout("Change password", p.CSRF, p.Error, p.Warnings) {
		if p.Forced {
			<p role="status">Choose a new password to continue.</p>
		}
		<form method="post" action="/account/password">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label>
				Current password
				<input type="password" name="current" autocomplete="current-password" required/>
			</label>
			<label>
				New password
				<input type="password" name="next" autocomplete="new-password" required/>
			</label>
			<label>
				Confirm new password
				<input type="password" name="confirm" autocomplete="new-password" required/>
			</label>
			<button type="submit">Change password</button>
		</form>
	}
}
