package views

import (
	"strconv"

	authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"
)

func (Default) User(p authweb.UserPage) templ.Component {
	return user(p)
}

templ user(p authweb.UserPage) {
	@layout(p.User.Name, p.CSRF, p.Error, p.Warnings) {
		<p>{ p.User.Email }</p>
		if p.AccessURL != "" {
			<p><a href={ templ.SafeURL(p.AccessURL) }>Site and project access</a></p>
		}
		<input type="hidden" name="version" value={ strconv.FormatInt(p.Version, 10) }/>
	}
}
