// Package views is the default templ set for authweb.Views: plain pages until
// Task 21 rebuilds them from internal/ui components (CD-88).
package views

import authweb "github.com/vardhan/internaltools/internal/kernel/auth/web"

// Default implements authweb.Views.
type Default struct{}

var _ authweb.Views = Default{}

// layout is the plain page shell: the title, the error in role="alert", the
// warnings and the session's CSRF token.
templ layout(title, csrf, errText string, warnings []string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ title }</title>
		</head>
		<body>
			<main>
				<h1>{ title }</h1>
				if errText != "" {
					<p role="alert">{ errText }</p>
				}
				for _, w := range warnings {
					<p role="status">{ w }</p>
				}
				<input type="hidden" name="csrf_token" value={ csrf }/>
				{ children... }
			</main>
		</body>
	</html>
}

func (Default) Password(p authweb.PasswordPage) templ.Component {
	return layout("Change password", p.CSRF, p.Error, p.Warnings)
}

func (Default) Sessions(p authweb.SessionsPage) templ.Component {
	return layout("Sessions", p.CSRF, p.Error, p.Warnings)
}

func (Default) Users(p authweb.UsersPage) templ.Component {
	return layout("Users", p.CSRF, p.Error, p.Warnings)
}

func (Default) User(p authweb.UserPage) templ.Component {
	return layout(p.User.Name, p.CSRF, p.Error, p.Warnings)
}
