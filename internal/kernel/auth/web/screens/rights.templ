package authscreens

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/vardhan/internaltools/internal/kernel/auth"
	"github.com/vardhan/internaltools/internal/kernel/doctype"
	"github.com/vardhan/internaltools/internal/ui/components"
	uilayout "github.com/vardhan/internaltools/internal/ui/layout"
)

// RightsPage edits Role's Rights on DocType (design-system §8.6). DocTypes are
// the role's DocTypes, shown beside the form from 64rem. Error, when set, shows
// in a Banner, with Rights and Role.Version as the page posted them (CD-94).
type RightsPage struct {
	Role     auth.RoleInfo
	DocType  *doctype.DocType
	DocTypes []*doctype.DocType
	Rights   map[auth.Right]auth.Scope
	Error    string
}

// rightMeanings is each right's one line on the page.
var rightMeanings = map[auth.Right]string{
	auth.RightRead:    "See records.",
	auth.RightCreate:  "Add new records.",
	auth.RightWrite:   "Change records.",
	auth.RightSubmit:  "Submit for approval or posting.",
	auth.RightApprove: "Approve or reject requests.",
	auth.RightCancel:  "Cancel submitted records.",
	auth.RightAmend:   "Amend cancelled records.",
	auth.RightDelete:  "Delete drafts.",
	auth.RightPrint:   "Print and save as PDF.",
	auth.RightExport:  "Export to CSV.",
	auth.RightImport:  "Import from CSV.",
}

// rightMeaning is rt's line on dt: a master has no drafts.
func rightMeaning(dt *doctype.DocType, rt auth.Right) string {
	if rt == auth.RightDelete && dt.Master != nil {
		return "Delete records."
	}
	return rightMeanings[rt]
}

// scopeLabels names each scope on the segmented control.
var scopeLabels = map[auth.Scope]string{auth.ScopeOwn: "Own", auth.ScopeTeam: "Team", auth.ScopeAll: "All"}

// scopeOptions are None, then dt's scopes: Team only where it is offered (CD-11).
func scopeOptions(dt *doctype.DocType) []components.Option {
	out := []components.Option{{Label: "None"}}
	for _, sc := range auth.ScopeOptions(dt) {
		out = append(out, components.Option{Value: string(sc), Label: scopeLabels[sc]})
	}
	return out
}

// notShownNote names the rights that don't apply to dt; empty when all do.
func notShownNote(dt *doctype.DocType) string {
	var names []string
	for _, rt := range auth.AllRights {
		if !auth.Applies(dt, rt) {
			names = append(names, auth.RightLabel(rt))
		}
	}
	if len(names) == 0 {
		return ""
	}
	return "Not shown because they don't apply to " + dt.Label + ": " + strings.Join(names, ", ") + "."
}

// Rights is one role's rights on one DocType: a row per right that applies,
// its label above the control so it fits at 320 px. From 64rem the role's
// DocTypes sit beside it; a phone shows only the form and the Back link.
templ Rights(p RightsPage) {
	{{ o := uilayout.PageOpts{Title: p.DocType.Label + " rights for " + p.Role.Name, Error: p.Error != "", Back: &components.Link{Label: p.Role.Name, Href: rolePath(p.Role.ID)}} }}
	if o.Error {
		{{ o.BannerSlot = components.Banner(components.BannerProps{Kind: components.Danger, Message: p.Error, Link: &components.Link{Label: "Reload", Href: RightsPath(p.Role.ID, p.DocType.Name)}}) }}
	}
	@uilayout.Page(o) {
		<div class="sidebar-layout">
			<nav class="pane-nav" aria-label="Document types">
				<ul>
					for _, dt := range p.DocTypes {
						<li>
							<a
								href={ templ.SafeURL(RightsPath(p.Role.ID, dt.Name)) }
								if dt.Name == p.DocType.Name {
									aria-current="page"
								}
							>{ dt.Label }</a>
						</li>
					}
				</ul>
			</nav>
			<div class="stack form-width">
				@components.Form(components.FormProps{Action: RightsPath(p.Role.ID, p.DocType.Name)}) {
					@components.Hidden("version", strconv.FormatInt(p.Role.Version, 10))
					<div class="stack">
						for _, rt := range applicableRights(p.DocType) {
							@components.Segmented(components.FieldProps{
								ID: components.FieldID(string(rt)), Name: string(rt), Label: auth.RightLabel(rt),
								Hint: rightMeaning(p.DocType, rt), Value: string(p.Rights[rt]),
							}, scopeOptions(p.DocType))
						}
						@components.Button(components.ButtonProps{Label: "Save rights", Type: "submit", Variant: components.Primary})
					</div>
				}
				if note := notShownNote(p.DocType); note != "" {
					<p>{ note }</p>
				}
				@components.Disclosure("Reset to defaults", false) {
					<div class="stack">
						@components.Banner(components.BannerProps{Kind: components.Warning, Message: "This replaces every role's rights on " + p.DocType.Label + " with the defaults. It can't be undone."})
						@components.Form(components.FormProps{Action: "/rights/" + url.PathEscape(p.DocType.Name) + "/reset"}) {
							@components.Hidden("role_id", strconv.FormatInt(p.Role.ID, 10))
							@components.Button(components.ButtonProps{Label: "Reset " + p.DocType.Label + " to defaults for every role", Type: "submit", Variant: components.Danger, Busy: "Resetting…"})
						}
					</div>
				}
			</div>
		</div>
	}
}
