package print

import (
	"strconv"

	"github.com/vardhan/internaltools/internal/types"
)

// GRNDocument is the goods receipt print body: letterhead, title, PO and
// challan reference, vendor, and received, accepted and rejected quantities.
templ GRNDocument(d GRNDoc) {
	@LetterheadBlock(d.Letterhead)
	@DocTitle("Goods Receipt Note")
	<p class="doc-date">{ "Date: " + types.FormatDate(d.Date) }</p>
	<p class="po-ref">{ "Against PO: " + d.PONumber + " dated " + types.FormatDate(d.PODate) }</p>
	<p class="challan">{ challanLabel(d.ChallanLabel) + ": " + dashIfBlank(d.ChallanNo) }</p>
	if d.ChallanDate != (types.Date{}) {
		<p class="challan">{ "Challan Date: " + types.FormatDate(d.ChallanDate) }</p>
	}
	if d.VehicleNo != "" {
		<p class="vehicle">{ "Vehicle no.: " + d.VehicleNo }</p>
	}
	if d.Transporter != "" {
		<p class="transporter">{ "Transporter: " + d.Transporter }</p>
	}
	if d.EWayBillNo != "" {
		<p class="eway-bill">{ "E-way bill no.: " + d.EWayBillNo }</p>
	}
	@PartyBlock(d.Party)
	<table class="lines">
		<thead>
			<tr><th>Sr</th><th>Item</th><th>HSN</th><th>UoM</th><th>Received</th><th>Accepted</th><th>Rejected</th></tr>
		</thead>
		<tbody>
			for _, l := range d.Lines {
				<tr>
					<td class="sr">{ strconv.Itoa(l.Sr) }</td>
					if l.RejectReason != "" {
						<td class="item">{ l.Item }<div class="reject-reason">{ "Reason for rejecting: " + l.RejectReason }</div></td>
					} else {
						<td class="item">{ l.Item }</td>
					}
					<td class="hsn">{ l.HSN }</td>
					<td class="uom">{ l.UoM }</td>
					<td class="qty">{ types.FormatQty(l.Received) }</td>
					<td class="qty">{ types.FormatQty(l.Accepted) }</td>
					<td class="qty">{ types.FormatQty(l.Rejected) }</td>
				</tr>
			}
			if len(d.Lines) == 0 {
				<tr><td colspan="7">No items</td></tr>
			}
		</tbody>
	</table>
	if d.Remarks != "" {
		<p class="remarks">{ "Remarks: " + d.Remarks }</p>
	}
	if d.ReverseChargeNote != "" {
		<p class="reverse-charge">{ d.ReverseChargeNote }</p>
	}
	@Signatory(d.Letterhead.LegalName)
}

// challanLabel is the caller's label, or the neutral one when blank.
func challanLabel(l string) string {
	if l == "" {
		return "Challan or invoice no."
	}
	return l
}

// dashIfBlank prints a dash for a blank value.
func dashIfBlank(v string) string {
	if v == "" {
		return "-"
	}
	return v
}
