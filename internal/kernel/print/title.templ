package print

// DocTitle renders the document title with its status badge and number,
// read from the Header that Render put in ctx.
templ DocTitle(title string) {
	{{ h := HeaderFrom(ctx) }}
	<h1 class="doc-title">{ title }if h.Status.Code != "" {
			{ " " }<span class="doc_badge" data-status={ h.Status.Code }>{ h.Status.Label }</span>
		}</h1>
	<p class="doc-number">{ h.Number }</p>
}
