{
  "protocol": "docs/superpowers/plans/2026-10-25-execution-protocol.md",
  "progress": "docs/PROGRESS.md",
  "decision_log": "docs/specs/contract-changes.md",
  "ux_template": "docs/ux/TEMPLATE.md",
  "protected": [
    "docs/specs/*",
    "docs/research/*",
    "docs/superpowers/plans/*",
    "docs/tests/*"
  ],
  "commands": {
    "fast_test": "go test -race ./{pkg}/...",
    "handin": [
      "go test -race {dirs}",
      "bin/tools/golangci-lint run --new-from-rev={base} {dirs}"
    ],
    "merge": "make ci",
    "e2e": "make e2e"
  },
  "max_parallel_agents": 25,
  "assistant_directors": {
    "head": {
      "workers": 1,
      "does": "merges, decision log, PROGRESS.md, escalations, D0, U1/U2, owner"
    },
    "AD-9": {
      "wps": [
        "mod0 (M0-6..M0-14)"
      ],
      "workers": 8
    },
    "AD-10": {
      "wps": [
        "mod0-hooks (M0-1..M0-5)"
      ],
      "workers": 5
    },
    "AD-11": {
      "wps": [
        "mod-exp (MOD-EXP plan, EXP test docs, UX, build)"
      ],
      "workers": 5
    },
    "AD-12": {
      "wps": [
        "mod-grn (MOD-GRN plan, GRN test docs, UX, build)"
      ],
      "workers": 4
    },
    "AD-13": {
      "wps": [
        "mod-po (P1..P17)"
      ],
      "workers": 2
    }
  },
  "models": {
    "judgement": "opus",
    "mechanical": "haiku"
  },
  "schedule": "docs/superpowers/plans/2026-10-25-parallel-schedule.md"
}
